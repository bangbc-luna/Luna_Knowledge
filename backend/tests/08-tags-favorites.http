# @import ./_auth.http
@apiUrl = http://localhost:4000/api/v1

# Tag: thành viên (MEMBER trở lên) xem, tạo, gắn tag; ADMIN workspace hoặc System Admin sửa / xóa tag.

### Folder để gắn tag (creator tạo)
# @name tagged
# @ref creator
# @ref ws
POST {{apiUrl}}/workspaces/{{contentWs.id}}/folders
Authorization: Bearer {{creator.accessToken}}
Content-Type: application/json

{ "name": "Báo cáo tháng" }

?? status == 201

### Thành viên tạo tag
# @name tag
# @ref member
# @ref ws
POST {{apiUrl}}/workspaces/{{contentWs.id}}/tags
Authorization: Bearer {{member.accessToken}}
Content-Type: application/json

{ "name": "Quan trọng", "color": "#E5534B" }

?? status == 201
?? body color == #e5534b

### Tag trùng tên → 409
# @ref tag
POST {{apiUrl}}/workspaces/{{contentWs.id}}/tags
Authorization: Bearer {{creator.accessToken}}
Content-Type: application/json

{ "name": "Quan trọng", "color": "#000000" }

?? status == 409

### Màu sai định dạng → 400
# @ref member
# @ref ws
POST {{apiUrl}}/workspaces/{{contentWs.id}}/tags
Authorization: Bearer {{member.accessToken}}
Content-Type: application/json

{ "name": "Đỏ", "color": "red" }

?? status == 400

### Người không phải thành viên (chỉ được share) không tạo tag → 404
# @ref sharedViewer
# @ref ws
POST {{apiUrl}}/workspaces/{{contentWs.id}}/tags
Authorization: Bearer {{sharedViewer.accessToken}}
Content-Type: application/json

{ "name": "x", "color": "#000000" }

?? status == 404

### Danh sách tag (thành viên khác)
# @ref creator
# @ref tag
GET {{apiUrl}}/workspaces/{{contentWs.id}}/tags
Authorization: Bearer {{creator.accessToken}}

?? status == 200
?? js response.parsedBody.some(t => t.name === 'Quan trọng') == true

### MEMBER (EDITOR) gắn tag cho mục người khác tạo
# @ref member
# @ref tag
# @ref tagged
PUT {{apiUrl}}/nodes/{{tagged.id}}/tags
Authorization: Bearer {{member.accessToken}}
Content-Type: application/json

{ "tagIds": ["{{tag.id}}"] }

?? status == 200
?? js response.parsedBody.tags[0].name == Quan trọng

### Share "Chỉ xem" không gắn tag được → 403
# @ref sharedViewer
# @ref ws
PUT {{apiUrl}}/nodes/{{viewFolder.id}}/tags
Authorization: Bearer {{sharedViewer.accessToken}}
Content-Type: application/json

{ "tagIds": [] }

?? status == 403

### Người tạo tag cũng không sửa tag → 403
# @ref tag
PATCH {{apiUrl}}/tags/{{tag.id}}
Authorization: Bearer {{member.accessToken}}
Content-Type: application/json

{ "name": "Gấp" }

?? status == 403

### ADMIN workspace sửa tag
# @ref creator
# @ref tag
PATCH {{apiUrl}}/tags/{{tag.id}}
Authorization: Bearer {{creator.accessToken}}
Content-Type: application/json

{ "name": "Gấp" }

?? status == 200
?? body name == Gấp

### System Admin sửa tag
# @ref admin
# @ref tag
PATCH {{apiUrl}}/tags/{{tag.id}}
Authorization: Bearer {{admin.accessToken}}
Content-Type: application/json

{ "name": "Rất gấp" }

?? status == 200
?? body name == Rất gấp

### Đánh dấu yêu thích (người được share "Chỉ xem")
# @ref sharedViewer
# @ref ws
PUT {{apiUrl}}/nodes/{{viewFolder.id}}/favorite
Authorization: Bearer {{sharedViewer.accessToken}}

?? status == 204

### Danh sách yêu thích
# @ref sharedViewer
# @ref ws
GET {{apiUrl}}/me/favorites
Authorization: Bearer {{sharedViewer.accessToken}}

?? status == 200
?? js response.parsedBody.some(n => n.id === viewFolder.id && n.isFavorite) == true

### Bỏ yêu thích
# @ref sharedViewer
# @ref ws
DELETE {{apiUrl}}/nodes/{{viewFolder.id}}/favorite
Authorization: Bearer {{sharedViewer.accessToken}}

?? status == 204

### Không còn trong danh sách yêu thích
# @ref sharedViewer
# @ref ws
GET {{apiUrl}}/me/favorites
Authorization: Bearer {{sharedViewer.accessToken}}

?? status == 200
?? js response.parsedBody.some(n => n.id === viewFolder.id) == false

### Thành viên đánh dấu yêu thích
# @ref creator
# @ref tagged
PUT {{apiUrl}}/nodes/{{tagged.id}}/favorite
Authorization: Bearer {{creator.accessToken}}

?? status == 204

###
# @ref creator
# @ref tagged
GET {{apiUrl}}/me/favorites
Authorization: Bearer {{creator.accessToken}}

?? status == 200
?? js response.parsedBody.some(n => n.id === tagged.id && n.isFavorite) == true

### Mở gần đây (tài liệu/file/video; folder không được ghi)
# @ref sharedViewer
GET {{apiUrl}}/me/recent
Authorization: Bearer {{sharedViewer.accessToken}}

?? status == 200

### MEMBER không xóa tag → 403
# @ref tag
DELETE {{apiUrl}}/tags/{{tag.id}}
Authorization: Bearer {{member.accessToken}}

?? status == 403

### ADMIN workspace xóa tag → gỡ khỏi folder
# @ref creator
# @ref tag
DELETE {{apiUrl}}/tags/{{tag.id}}
Authorization: Bearer {{creator.accessToken}}

?? status == 204

### Tag tạm để System Admin xóa
# @name tempTag
# @ref member
# @ref ws
POST {{apiUrl}}/workspaces/{{contentWs.id}}/tags
Authorization: Bearer {{member.accessToken}}
Content-Type: application/json

{ "name": "Tạm {{$timestamp}}", "color": "#123456" }

?? status == 201

### System Admin xóa tag
# @ref admin
# @ref tempTag
DELETE {{apiUrl}}/tags/{{tempTag.id}}
Authorization: Bearer {{admin.accessToken}}

?? status == 204

### Folder không còn tag
# @ref member
# @ref tagged
GET {{apiUrl}}/nodes/{{tagged.id}}
Authorization: Bearer {{member.accessToken}}

?? status == 200
?? js response.parsedBody.tags.length == 0
