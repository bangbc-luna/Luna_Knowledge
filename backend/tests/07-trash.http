# @import ./_auth.http
@apiUrl = http://localhost:4000/api/v1

# Xóa (đưa vào thùng rác): EDITOR trở lên (thành viên MEMBER xóa được mọi mục, kể cả mục người khác tạo).
# Thùng rác: MEMBER trở lên hoặc System Admin xem (VIEWER của workspace công ty → 403).
# Khôi phục: người đã xóa, ADMIN workspace hoặc System Admin.
# Xóa vĩnh viễn / dọn sạch: ADMIN workspace hoặc System Admin.

### Folder sẽ xóa
# @name trashRoot
# @ref member
# @ref ws
POST {{apiUrl}}/workspaces/{{contentWs.id}}/folders
Authorization: Bearer {{member.accessToken}}
Content-Type: application/json

{ "name": "Tài liệu cũ" }

?? status == 201

### Folder con
# @name trashChild
# @ref trashRoot
POST {{apiUrl}}/workspaces/{{contentWs.id}}/folders
Authorization: Bearer {{member.accessToken}}
Content-Type: application/json

{ "name": "2024", "parentId": "{{trashRoot.id}}" }

?? status == 201

### Folder của creator
# @name ownersFolder
# @ref creator
# @ref ws
POST {{apiUrl}}/workspaces/{{contentWs.id}}/folders
Authorization: Bearer {{creator.accessToken}}
Content-Type: application/json

{ "name": "Của creator {{$timestamp}}" }

?? status == 201

### member xóa folder của mình (cả nhánh) → 204
# @ref trashChild
DELETE {{apiUrl}}/nodes/{{trashRoot.id}}
Authorization: Bearer {{member.accessToken}}

?? status == 204

### Mục con không còn truy cập → 404
# @ref trashChild
GET {{apiUrl}}/nodes/{{trashChild.id}}
Authorization: Bearer {{member.accessToken}}

?? status == 404

### Thùng rác (MEMBER xem được): mỗi lần xóa một dòng, kèm số mục
# @ref member
# @ref trashChild
GET {{apiUrl}}/workspaces/{{contentWs.id}}/trash
Authorization: Bearer {{member.accessToken}}

?? status == 200
?? js response.parsedBody.find(t => t.id === trashRoot.id).itemCount == 2
?? js response.parsedBody.find(t => t.id === trashRoot.id).deletedBy.email == qa.member@lunatech.vn

### Người không phải thành viên (chỉ được share) không xem thùng rác → 404
# @ref sharedViewer
# @ref ws
GET {{apiUrl}}/workspaces/{{contentWs.id}}/trash
Authorization: Bearer {{sharedViewer.accessToken}}

?? status == 404

### Workspace công ty
# @name companyWs
# @ref member
GET {{apiUrl}}/workspaces
Authorization: Bearer {{member.accessToken}}

?? status == 200

### VIEWER của workspace công ty không xem thùng rác → 403
# @ref companyWs
GET {{apiUrl}}/workspaces/{{companyWs.find(w => w.slug === 'lunatech').id}}/trash
Authorization: Bearer {{member.accessToken}}

?? status == 403

### Chỉ khôi phục được mục gốc của lần xóa → 400
# @ref trashChild
POST {{apiUrl}}/nodes/{{trashChild.id}}/restore
Authorization: Bearer {{member.accessToken}}

?? status == 400

### creator (ADMIN) xóa folder của mình
# @ref creator
# @ref ownersFolder
DELETE {{apiUrl}}/nodes/{{ownersFolder.id}}
Authorization: Bearer {{creator.accessToken}}

?? status == 204

### MEMBER không phải người xóa không khôi phục được → 403
# @ref member
# @ref ownersFolder
POST {{apiUrl}}/nodes/{{ownersFolder.id}}/restore
Authorization: Bearer {{member.accessToken}}

?? status == 403

### System Admin khôi phục mục người khác đã xóa
# @ref admin
# @ref ownersFolder
POST {{apiUrl}}/nodes/{{ownersFolder.id}}/restore
Authorization: Bearer {{admin.accessToken}}

?? status == 200
?? body renamed == false

### MEMBER xóa được mục người khác tạo → 204
# @ref member
# @ref ownersFolder
DELETE {{apiUrl}}/nodes/{{ownersFolder.id}}
Authorization: Bearer {{member.accessToken}}

?? status == 204

### ADMIN workspace khôi phục mục người khác đã xóa
# @ref creator
# @ref ownersFolder
POST {{apiUrl}}/nodes/{{ownersFolder.id}}/restore
Authorization: Bearer {{creator.accessToken}}

?? status == 200
?? body renamed == false

### Tạo folder trùng tên ở chỗ cũ
# @ref member
# @ref ws
POST {{apiUrl}}/workspaces/{{contentWs.id}}/folders
Authorization: Bearer {{member.accessToken}}
Content-Type: application/json

{ "name": "Tài liệu cũ" }

?? status == 201

### Người đã xóa khôi phục: trùng tên nên tự đổi thành "Tài liệu cũ (1)"
# @ref trashChild
POST {{apiUrl}}/nodes/{{trashRoot.id}}/restore
Authorization: Bearer {{member.accessToken}}

?? status == 200
?? body renamed == true
?? body node.name == Tài liệu cũ (1)
?? body node.childCount == 1

### Xóa lại để thử xóa vĩnh viễn
# @ref trashChild
DELETE {{apiUrl}}/nodes/{{trashRoot.id}}
Authorization: Bearer {{member.accessToken}}

?? status == 204

### Người đã xóa (MEMBER) không xóa vĩnh viễn được → 403
# @ref trashChild
DELETE {{apiUrl}}/nodes/{{trashRoot.id}}/permanent
Authorization: Bearer {{member.accessToken}}

?? status == 403

### ADMIN workspace xóa vĩnh viễn → 204
# @ref creator
# @ref trashChild
DELETE {{apiUrl}}/nodes/{{trashRoot.id}}/permanent
Authorization: Bearer {{creator.accessToken}}

?? status == 204

### Xóa lại folder của creator
# @ref member
# @ref ownersFolder
DELETE {{apiUrl}}/nodes/{{ownersFolder.id}}
Authorization: Bearer {{member.accessToken}}

?? status == 204

### System Admin xóa vĩnh viễn → 204
# @ref admin
# @ref ownersFolder
DELETE {{apiUrl}}/nodes/{{ownersFolder.id}}/permanent
Authorization: Bearer {{admin.accessToken}}

?? status == 204

### Folder để dọn thùng rác
# @name junk
# @ref member
# @ref ws
POST {{apiUrl}}/workspaces/{{contentWs.id}}/folders
Authorization: Bearer {{member.accessToken}}
Content-Type: application/json

{ "name": "Rác {{$timestamp}}" }

?? status == 201

###
# @ref junk
DELETE {{apiUrl}}/nodes/{{junk.id}}
Authorization: Bearer {{member.accessToken}}

?? status == 204

### MEMBER không dọn sạch thùng rác được → 403
# @ref member
# @ref ws
DELETE {{apiUrl}}/workspaces/{{contentWs.id}}/trash
Authorization: Bearer {{member.accessToken}}

?? status == 403

### ADMIN workspace dọn sạch thùng rác
# @ref creator
# @ref ws
DELETE {{apiUrl}}/workspaces/{{contentWs.id}}/trash
Authorization: Bearer {{creator.accessToken}}

?? status == 200
?? body deleted >= 1

### System Admin dọn sạch thùng rác (đã trống)
# @ref admin
# @ref ws
DELETE {{apiUrl}}/workspaces/{{contentWs.id}}/trash
Authorization: Bearer {{admin.accessToken}}

?? status == 200
?? body deleted == 0

### Thùng rác trống
# @ref member
# @ref ws
GET {{apiUrl}}/workspaces/{{contentWs.id}}/trash
Authorization: Bearer {{member.accessToken}}

?? status == 200
?? js response.parsedBody.length == 0
