# @import ./_auth.http
@apiUrl = http://localhost:4000/api/v1

# Xóa (đưa vào thùng rác): OWNER của mục (người tạo mục / folder cha, hoặc share "Được chỉnh sửa").
# Thùng rác: thành viên xem; người đã xóa hoặc System Admin khôi phục; chỉ System Admin xóa vĩnh viễn / dọn sạch.

### Folder sẽ xóa
# @name trashRoot
# @ref member
# @ref ws
POST {{apiUrl}}/workspaces/{{contentWs.id}}/folders
Authorization: Bearer {{member.accessToken}}
Content-Type: application/json

{ "name": "Tài liệu cũ" }

?? status == 201

### Folder con
# @name trashChild
# @ref trashRoot
POST {{apiUrl}}/workspaces/{{contentWs.id}}/folders
Authorization: Bearer {{member.accessToken}}
Content-Type: application/json

{ "name": "2024", "parentId": "{{trashRoot.id}}" }

?? status == 201

### Folder của creator
# @name ownersFolder
# @ref creator
# @ref ws
POST {{apiUrl}}/workspaces/{{contentWs.id}}/folders
Authorization: Bearer {{creator.accessToken}}
Content-Type: application/json

{ "name": "Của creator {{$timestamp}}" }

?? status == 201

### Thành viên không xóa mục người khác tạo → 403
# @ref member
# @ref ownersFolder
DELETE {{apiUrl}}/nodes/{{ownersFolder.id}}
Authorization: Bearer {{member.accessToken}}

?? status == 403

### member xóa folder của mình (cả nhánh) → 204
# @ref trashChild
DELETE {{apiUrl}}/nodes/{{trashRoot.id}}
Authorization: Bearer {{member.accessToken}}

?? status == 204

### Mục con không còn truy cập → 404
# @ref trashChild
GET {{apiUrl}}/nodes/{{trashChild.id}}
Authorization: Bearer {{member.accessToken}}

?? status == 404

### Thùng rác (thành viên bất kỳ xem được): mỗi lần xóa một dòng, kèm số mục
# @ref creator
# @ref trashChild
GET {{apiUrl}}/workspaces/{{contentWs.id}}/trash
Authorization: Bearer {{creator.accessToken}}

?? status == 200
?? js response.parsedBody.find(t => t.id === trashRoot.id).itemCount == 2
?? js response.parsedBody.find(t => t.id === trashRoot.id).deletedBy.email == qa.member@lunatech.vn

### Người không phải thành viên (chỉ được share) không xem thùng rác → 404
# @ref sharedViewer
# @ref ws
GET {{apiUrl}}/workspaces/{{contentWs.id}}/trash
Authorization: Bearer {{sharedViewer.accessToken}}

?? status == 404

### Chỉ khôi phục được mục gốc của lần xóa → 400
# @ref trashChild
POST {{apiUrl}}/nodes/{{trashChild.id}}/restore
Authorization: Bearer {{member.accessToken}}

?? status == 400

### Thành viên khác (không phải người xóa) không khôi phục được → 403
# @ref creator
# @ref trashChild
POST {{apiUrl}}/nodes/{{trashRoot.id}}/restore
Authorization: Bearer {{creator.accessToken}}

?? status == 403

### Tạo folder trùng tên ở chỗ cũ
# @ref member
# @ref ws
POST {{apiUrl}}/workspaces/{{contentWs.id}}/folders
Authorization: Bearer {{member.accessToken}}
Content-Type: application/json

{ "name": "Tài liệu cũ" }

?? status == 201

### Người đã xóa khôi phục: trùng tên nên tự đổi thành "Tài liệu cũ (1)"
# @ref trashChild
POST {{apiUrl}}/nodes/{{trashRoot.id}}/restore
Authorization: Bearer {{member.accessToken}}

?? status == 200
?? body renamed == true
?? body node.name == Tài liệu cũ (1)
?? body node.childCount == 1

### Xóa lại để thử xóa vĩnh viễn
# @ref trashChild
DELETE {{apiUrl}}/nodes/{{trashRoot.id}}
Authorization: Bearer {{member.accessToken}}

?? status == 204

### Người đã xóa cũng không xóa vĩnh viễn được → 403
# @ref trashChild
DELETE {{apiUrl}}/nodes/{{trashRoot.id}}/permanent
Authorization: Bearer {{member.accessToken}}

?? status == 403

### Thành viên khác không xóa vĩnh viễn được → 403
# @ref creator
# @ref trashChild
DELETE {{apiUrl}}/nodes/{{trashRoot.id}}/permanent
Authorization: Bearer {{creator.accessToken}}

?? status == 403

### System Admin xóa vĩnh viễn → 204
# @ref admin
# @ref trashChild
DELETE {{apiUrl}}/nodes/{{trashRoot.id}}/permanent
Authorization: Bearer {{admin.accessToken}}

?? status == 204

### creator xóa folder của mình → 204
# @ref creator
# @ref ownersFolder
DELETE {{apiUrl}}/nodes/{{ownersFolder.id}}
Authorization: Bearer {{creator.accessToken}}

?? status == 204

### System Admin khôi phục mục người khác đã xóa
# @ref admin
# @ref ownersFolder
POST {{apiUrl}}/nodes/{{ownersFolder.id}}/restore
Authorization: Bearer {{admin.accessToken}}

?? status == 200
?? body renamed == false

### Xóa lại để dọn thùng rác
# @ref creator
# @ref ownersFolder
DELETE {{apiUrl}}/nodes/{{ownersFolder.id}}
Authorization: Bearer {{creator.accessToken}}

?? status == 204

### Thành viên không dọn sạch thùng rác được → 403
# @ref creator
# @ref ws
DELETE {{apiUrl}}/workspaces/{{contentWs.id}}/trash
Authorization: Bearer {{creator.accessToken}}

?? status == 403

### System Admin dọn sạch thùng rác
# @ref admin
# @ref ws
DELETE {{apiUrl}}/workspaces/{{contentWs.id}}/trash
Authorization: Bearer {{admin.accessToken}}

?? status == 200
?? body deleted >= 1

### Thùng rác trống
# @ref creator
# @ref ws
GET {{apiUrl}}/workspaces/{{contentWs.id}}/trash
Authorization: Bearer {{creator.accessToken}}

?? status == 200
?? js response.parsedBody.length == 0
