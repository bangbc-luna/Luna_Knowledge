# @import ./_auth.http
@apiUrl = http://localhost:4000/api/v1

# Thành viên workspace chỉ có một vai trò MEMBER. Chỉ System Admin thêm / gỡ thành viên;
# thành viên tự rời được. Không còn đổi vai trò hay chuyển OWNER.

### Tạo workspace cho test thành viên (creator là thành viên ban đầu)
# @name ws
# @ref admin
# @ref creator
# @ref member
# @ref sharedViewer
POST {{apiUrl}}/workspaces
Authorization: Bearer {{admin.accessToken}}
Content-Type: application/json

{ "name": "QA Members", "slug": "qa-members-{{$timestamp}}", "memberEmails": ["qa.creator@lunatech.vn"] }

?? status == 201
?? body memberCount == 1

### Admin thêm member (không cần chọn vai trò)
# @ref ws
POST {{apiUrl}}/workspaces/{{ws.id}}/members
Authorization: Bearer {{admin.accessToken}}
Content-Type: application/json

{ "email": "qa.member@lunatech.vn" }

?? status == 201
?? body role == MEMBER
?? body user.email == qa.member@lunatech.vn

### Admin thêm sharedViewer
# @ref ws
POST {{apiUrl}}/workspaces/{{ws.id}}/members
Authorization: Bearer {{admin.accessToken}}
Content-Type: application/json

{ "email": "qa.shared.viewer@lunatech.vn" }

?? status == 201

### Thêm người chưa từng đăng nhập
# @ref ws
POST {{apiUrl}}/workspaces/{{ws.id}}/members
Authorization: Bearer {{admin.accessToken}}
Content-Type: application/json

{ "email": "qa.newbie@lunatech.vn" }

?? status == 201
?? body role == MEMBER

### Thêm trùng → 409
# @ref ws
POST {{apiUrl}}/workspaces/{{ws.id}}/members
Authorization: Bearer {{admin.accessToken}}
Content-Type: application/json

{ "email": "qa.member@lunatech.vn" }

?? status == 409

### Email ngoài công ty → 400
# @ref ws
POST {{apiUrl}}/workspaces/{{ws.id}}/members
Authorization: Bearer {{admin.accessToken}}
Content-Type: application/json

{ "email": "partner@gmail.com" }

?? status == 400

### Thành viên không thêm được thành viên → 403
# @ref ws
POST {{apiUrl}}/workspaces/{{ws.id}}/members
Authorization: Bearer {{creator.accessToken}}
Content-Type: application/json

{ "email": "qa.someone@lunatech.vn" }

?? status == 403

### Người ngoài thêm thành viên → 404
# @ref outsider
# @ref ws
POST {{apiUrl}}/workspaces/{{ws.id}}/members
Authorization: Bearer {{outsider.accessToken}}
Content-Type: application/json

{ "email": "qa.someone@lunatech.vn" }

?? status == 404

### Thành viên xem danh sách: ai cũng là MEMBER
# @ref ws
GET {{apiUrl}}/workspaces/{{ws.id}}/members
Authorization: Bearer {{sharedViewer.accessToken}}

?? status == 200
?? js response.parsedBody.length == 4
?? js response.parsedBody.every(m => m.role === 'MEMBER') == true

### Người ngoài xem danh sách → 404
# @ref outsider
# @ref ws
GET {{apiUrl}}/workspaces/{{ws.id}}/members
Authorization: Bearer {{outsider.accessToken}}

?? status == 404

### System Admin xem danh sách dù không phải thành viên
# @ref ws
GET {{apiUrl}}/workspaces/{{ws.id}}/members
Authorization: Bearer {{admin.accessToken}}

?? status == 200

### Đổi vai trò thành viên: API đã bỏ → 404
# @ref ws
PATCH {{apiUrl}}/workspaces/{{ws.id}}/members/{{member.user.id}}
Authorization: Bearer {{admin.accessToken}}
Content-Type: application/json

{ "role": "VIEWER" }

?? status == 404

### Chuyển quyền OWNER: API đã bỏ → 404
# @ref ws
POST {{apiUrl}}/workspaces/{{ws.id}}/transfer-ownership
Authorization: Bearer {{admin.accessToken}}
Content-Type: application/json

{ "userId": "{{member.user.id}}" }

?? status == 404

### Thành viên gỡ người khác → 403
# @ref ws
DELETE {{apiUrl}}/workspaces/{{ws.id}}/members/{{member.user.id}}
Authorization: Bearer {{creator.accessToken}}

?? status == 403

### Admin gỡ người không phải thành viên → 404
# @ref ws
DELETE {{apiUrl}}/workspaces/{{ws.id}}/members/00000000-0000-7000-8000-000000000000
Authorization: Bearer {{admin.accessToken}}

?? status == 404

### Admin gỡ member → 204
# @ref ws
DELETE {{apiUrl}}/workspaces/{{ws.id}}/members/{{member.user.id}}
Authorization: Bearer {{admin.accessToken}}

?? status == 204

### Bị gỡ → không còn xem được workspace (404)
# @ref ws
GET {{apiUrl}}/workspaces/{{ws.id}}
Authorization: Bearer {{member.accessToken}}

?? status == 404

### Thành viên tự rời workspace → 204
# @ref ws
DELETE {{apiUrl}}/workspaces/{{ws.id}}/members/{{sharedViewer.user.id}}
Authorization: Bearer {{sharedViewer.accessToken}}

?? status == 204

### Đã rời → 404
# @ref ws
GET {{apiUrl}}/workspaces/{{ws.id}}
Authorization: Bearer {{sharedViewer.accessToken}}

?? status == 404

### Còn lại creator và người mới
# @ref ws
GET {{apiUrl}}/workspaces/{{ws.id}}/members
Authorization: Bearer {{creator.accessToken}}

?? status == 200
?? js response.parsedBody.map(m => m.user.email).sort().join(',') == qa.creator@lunatech.vn,qa.newbie@lunatech.vn

### Dọn dẹp: admin xóa workspace
# @ref ws
DELETE {{apiUrl}}/workspaces/{{ws.id}}
Authorization: Bearer {{admin.accessToken}}

?? status == 204
