### wsAdmin (sẽ là ADMIN trong workspace test)
# @name wsAdmin
POST {{apiUrl}}/dev/token
Content-Type: application/json

{ "email": "qa.wsadmin@lunatech.vn", "name": "QA WS Admin" }

?? status == 200

### workspace dùng chung cho các file 05–08: owner=OWNER, wsAdmin=ADMIN, editor=EDITOR, viewer=VIEWER
# @name contentWs
# @ref admin
# @ref owner
# @ref wsAdmin
# @ref editor
# @ref viewer
POST {{apiUrl}}/workspaces
Authorization: Bearer {{admin.accessToken}}
Content-Type: application/json

{ "name": "QA Content", "slug": "qa-content-{{$timestamp}}", "ownerEmail": "qa.owner@lunatech.vn" }

?? status == 201

###
# @name contentWsAdmin
# @ref owner
# @ref contentWs
POST {{apiUrl}}/workspaces/{{contentWs.id}}/members
Authorization: Bearer {{owner.accessToken}}
Content-Type: application/json

{ "email": "qa.wsadmin@lunatech.vn", "role": "ADMIN" }

?? status == 201

###
# @name contentWsEditor
# @ref contentWsAdmin
POST {{apiUrl}}/workspaces/{{contentWs.id}}/members
Authorization: Bearer {{owner.accessToken}}
Content-Type: application/json

{ "email": "qa.editor@lunatech.vn", "role": "EDITOR" }

?? status == 201

### Workspace test đã sẵn sàng (dùng # @ref ws trong các file khác)
# @name ws
# @ref contentWsEditor
POST {{apiUrl}}/workspaces/{{contentWs.id}}/members
Authorization: Bearer {{owner.accessToken}}
Content-Type: application/json

{ "email": "qa.viewer@lunatech.vn", "role": "VIEWER" }

?? status == 201
