### Workspace nhóm dùng chung cho các file 05–13 (creator tạo nên là ADMIN của workspace).
# Quy ước vai trò trong workspace test:
#   creator       = ADMIN của workspace → OWNER trên mọi mục (quản lý share, xem hoạt động, xóa vĩnh viễn)
#   member        = MEMBER → EDITOR trên mọi mục (tạo, sửa, di chuyển, xóa vào thùng rác, gắn tag)
#   sharedViewer  = KHÔNG phải thành viên, chỉ được share "Chỉ xem" (VIEWER) folder `viewFolder`
#   sharedEditor  = KHÔNG phải thành viên, được share "Được chỉnh sửa" (EDITOR) trong 06 → OWNER trên nhánh đó
#   outsider      = không phải thành viên, không được share gì (06 share riêng cho outsider)
#   admin         = System Admin, không phải thành viên
# Mọi người dùng đều là VIEWER của workspace công ty `lunatech`.
# @name contentWs
# @ref admin
# @ref creator
# @ref member
# @ref sharedViewer
# @ref outsider
POST {{apiUrl}}/workspaces
Authorization: Bearer {{creator.accessToken}}
Content-Type: application/json

{
  "name": "QA Content",
  "slug": "qa-content-{{$timestamp}}",
  "memberEmails": ["qa.member@lunatech.vn"]
}

?? status == 201
?? body kind == TEAM
?? body memberCount == 2
?? body myRole == ADMIN

### Folder "Chỉ xem" do creator tạo (creator là ADMIN workspace nên là OWNER)
# @name viewFolder
# @ref contentWs
POST {{apiUrl}}/workspaces/{{contentWs.id}}/folders
Authorization: Bearer {{creator.accessToken}}
Content-Type: application/json

{ "name": "QA Chỉ xem {{$timestamp}}" }

?? status == 201
?? body myRole == OWNER

### Workspace test đã sẵn sàng (dùng # @ref ws trong các file khác): sharedViewer được share VIEWER folder viewFolder
# @name ws
# @ref viewFolder
POST {{apiUrl}}/nodes/{{viewFolder.id}}/shares
Authorization: Bearer {{creator.accessToken}}
Content-Type: application/json

{ "email": "qa.shared.viewer@lunatech.vn", "role": "VIEWER" }

?? status == 201
?? body role == VIEWER
