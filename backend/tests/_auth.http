### Workspace dùng chung cho các file 05–12 (System Admin tạo, không tự thành viên).
# Quy ước vai trò trong workspace test:
#   creator, member = thành viên (MEMBER) → quyền EDITOR trên mọi mục; ai tạo mục thì là OWNER của mục đó và mục con
#   sharedViewer        = KHÔNG phải thành viên, chỉ được share "Chỉ xem" (VIEWER) folder `viewFolder`
#   sharedEditor  = KHÔNG phải thành viên, được share "Được chỉnh sửa" (EDITOR) trong 06 → OWNER trên nhánh đó
#   outsider      = không phải thành viên, không được share gì (06 share riêng cho outsider)
#   admin         = System Admin, không phải thành viên
# @name contentWs
# @ref admin
# @ref creator
# @ref member
# @ref sharedViewer
# @ref outsider
POST {{apiUrl}}/workspaces
Authorization: Bearer {{admin.accessToken}}
Content-Type: application/json

{
  "name": "QA Content",
  "slug": "qa-content-{{$timestamp}}",
  "memberEmails": ["qa.creator@lunatech.vn", "qa.member@lunatech.vn"]
}

?? status == 201
?? body memberCount == 2
?? body myRole isFalse

### Folder "Chỉ xem" do creator tạo (creator là OWNER của folder này)
# @name viewFolder
# @ref contentWs
POST {{apiUrl}}/workspaces/{{contentWs.id}}/folders
Authorization: Bearer {{creator.accessToken}}
Content-Type: application/json

{ "name": "QA Chỉ xem {{$timestamp}}" }

?? status == 201
?? body myRole == OWNER

### Workspace test đã sẵn sàng (dùng # @ref ws trong các file khác): sharedViewer được share VIEWER folder viewFolder
# @name ws
# @ref viewFolder
POST {{apiUrl}}/nodes/{{viewFolder.id}}/shares
Authorization: Bearer {{creator.accessToken}}
Content-Type: application/json

{ "email": "qa.shared.viewer@lunatech.vn", "role": "VIEWER" }

?? status == 201
?? body role == VIEWER
