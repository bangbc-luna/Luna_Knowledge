# @import ./_auth.http
@apiUrl = http://localhost:4000/api/v1

# Quyền trên mục theo vai trò workspace: ADMIN → OWNER, MEMBER → EDITOR, VIEWER → VIEWER.
# Người tạo mục không còn tự là OWNER. creator là ADMIN, member là MEMBER của contentWs.
# sharedViewer chỉ được share "Chỉ xem" folder viewFolder.

### member tạo folder ở gốc → EDITOR (người tạo không tự thành OWNER)
# @name projects
# @ref member
# @ref ws
POST {{apiUrl}}/workspaces/{{contentWs.id}}/folders
Authorization: Bearer {{member.accessToken}}
Content-Type: application/json

{ "name": "Dự án" }

?? status == 201
?? body type == FOLDER
?? body section == DOCS
?? body myRole == EDITOR

### Tạo folder con
# @name design
# @ref projects
POST {{apiUrl}}/workspaces/{{contentWs.id}}/folders
Authorization: Bearer {{member.accessToken}}
Content-Type: application/json

{ "name": "Thiết kế", "parentId": "{{projects.id}}" }

?? status == 201
?? body parentId == {{projects.id}}

### Folder cháu
# @name mockups
# @ref design
POST {{apiUrl}}/workspaces/{{contentWs.id}}/folders
Authorization: Bearer {{member.accessToken}}
Content-Type: application/json

{ "name": "Mockup", "parentId": "{{design.id}}" }

?? status == 201

### Trùng tên (không phân biệt hoa thường) → 409 kèm gợi ý
# @ref projects
POST {{apiUrl}}/workspaces/{{contentWs.id}}/folders
Authorization: Bearer {{member.accessToken}}
Content-Type: application/json

{ "name": "DỰ ÁN" }

?? status == 409
?? body error.details.suggestion == DỰ ÁN (1)

### Tên chứa "/" → 400
# @ref member
# @ref ws
POST {{apiUrl}}/workspaces/{{contentWs.id}}/folders
Authorization: Bearer {{member.accessToken}}
Content-Type: application/json

{ "name": "a/b" }

?? status == 400

### ADMIN workspace (creator) thấy folder của member với quyền OWNER
# @ref creator
# @ref design
GET {{apiUrl}}/nodes/{{design.id}}
Authorization: Bearer {{creator.accessToken}}

?? status == 200
?? body name == Thiết kế
?? body myRole == OWNER

### ADMIN tạo folder trong folder của member (OWNER)
# @name ownersSub
# @ref creator
# @ref projects
POST {{apiUrl}}/workspaces/{{contentWs.id}}/folders
Authorization: Bearer {{creator.accessToken}}
Content-Type: application/json

{ "name": "Của creator {{$timestamp}}", "parentId": "{{projects.id}}" }

?? status == 201
?? body myRole == OWNER

### Người tạo folder cha (member) chỉ là EDITOR của mục con
# @ref ownersSub
GET {{apiUrl}}/nodes/{{ownersSub.id}}
Authorization: Bearer {{member.accessToken}}

?? status == 200
?? body myRole == EDITOR

### Người được share "Chỉ xem" không tạo được folder bên trong → 403
# @ref sharedViewer
# @ref ws
POST {{apiUrl}}/workspaces/{{contentWs.id}}/folders
Authorization: Bearer {{sharedViewer.accessToken}}
Content-Type: application/json

{ "name": "Không được", "parentId": "{{viewFolder.id}}" }

?? status == 403

### Người được share không tạo được ở gốc workspace → 404
# @ref sharedViewer
# @ref ws
POST {{apiUrl}}/workspaces/{{contentWs.id}}/folders
Authorization: Bearer {{sharedViewer.accessToken}}
Content-Type: application/json

{ "name": "Không được" }

?? status == 404

### Người ngoài → 404
# @ref outsider
# @ref ws
GET {{apiUrl}}/workspaces/{{contentWs.id}}/nodes
Authorization: Bearer {{outsider.accessToken}}

?? status == 404

### System Admin không phải thành viên không xem được nội dung → 404
# @ref admin
# @ref ws
GET {{apiUrl}}/workspaces/{{contentWs.id}}/nodes
Authorization: Bearer {{admin.accessToken}}

?? status == 404

### Liệt kê gốc workspace (khu Tài liệu mặc định)
# @ref creator
# @ref mockups
# @ref ownersSub
GET {{apiUrl}}/workspaces/{{contentWs.id}}/nodes
Authorization: Bearer {{creator.accessToken}}

?? status == 200
?? js response.parsedBody.items.some(n => n.name === 'Dự án' && n.childCount === 2) == true
?? js response.parsedBody.items.every(n => n.section === 'DOCS') == true

### Liệt kê folder con, sắp theo ngày tạo mới nhất, 1 mục/trang
# @ref creator
# @ref mockups
GET {{apiUrl}}/workspaces/{{contentWs.id}}/nodes?parentId={{projects.id}}&sort=createdAt&order=desc&limit=1
Authorization: Bearer {{creator.accessToken}}

?? status == 200
?? js response.parsedBody.items.length == 1

### Folder trong khu "Chỉ xem"
# @name handbook
# @ref member
# @ref ws
POST {{apiUrl}}/workspaces/{{contentWs.id}}/folders
Authorization: Bearer {{member.accessToken}}
Content-Type: application/json

{ "name": "Sổ tay {{$timestamp}}", "parentId": "{{viewFolder.id}}" }

?? status == 201

### Người được share "Chỉ xem" mở folder con → VIEWER
# @ref sharedViewer
# @ref handbook
GET {{apiUrl}}/nodes/{{handbook.id}}
Authorization: Bearer {{sharedViewer.accessToken}}

?? status == 200
?? body myRole == VIEWER

### Người được share "Chỉ xem" đổi tên → 403
# @ref sharedViewer
# @ref handbook
PATCH {{apiUrl}}/nodes/{{handbook.id}}
Authorization: Bearer {{sharedViewer.accessToken}}
Content-Type: application/json

{ "name": "x" }

?? status == 403

### Breadcrumb
# @ref creator
# @ref mockups
GET {{apiUrl}}/nodes/{{mockups.id}}/breadcrumb
Authorization: Bearer {{creator.accessToken}}

?? status == 200
?? js response.parsedBody.map(x => x.name).join(' / ') == Dự án / Thiết kế / Mockup

### ADMIN đổi tên mục người khác tạo
# @ref creator
# @ref mockups
PATCH {{apiUrl}}/nodes/{{mockups.id}}
Authorization: Bearer {{creator.accessToken}}
Content-Type: application/json

{ "name": "Mockup v2" }

?? status == 200
?? body name == Mockup v2

### ADMIN di chuyển mục người khác tạo: "Mockup v2" ra gốc
# @ref creator
# @ref mockups
POST {{apiUrl}}/nodes/{{mockups.id}}/move
Authorization: Bearer {{creator.accessToken}}
Content-Type: application/json

{ "targetParentId": null }

?? status == 200
?? body parentId isFalse

### Di chuyển "Dự án" vào chính folder con của nó → 400
# @ref member
# @ref design
POST {{apiUrl}}/nodes/{{projects.id}}/move
Authorization: Bearer {{member.accessToken}}
Content-Type: application/json

{ "targetParentId": "{{design.id}}" }

?? status == 400

### Đưa "Thiết kế" vào "Mockup v2" (cả nhánh di chuyển theo)
# @ref member
# @ref design
# @ref mockups
POST {{apiUrl}}/nodes/{{design.id}}/move
Authorization: Bearer {{member.accessToken}}
Content-Type: application/json

{ "targetParentId": "{{mockups.id}}" }

?? status == 200
?? body parentId == {{mockups.id}}

### Breadcrumb sau khi di chuyển
# @ref member
# @ref design
GET {{apiUrl}}/nodes/{{design.id}}/breadcrumb
Authorization: Bearer {{member.accessToken}}

?? status == 200
?? js response.parsedBody.map(x => x.name).join(' / ') == Mockup v2 / Thiết kế

### Khu Video: tạo folder ở gốc với section VIDEOS
# @name videoArea
# @ref member
# @ref ws
POST {{apiUrl}}/workspaces/{{contentWs.id}}/folders
Authorization: Bearer {{member.accessToken}}
Content-Type: application/json

{ "name": "Video đào tạo {{$timestamp}}", "section": "VIDEOS" }

?? status == 201
?? body section == VIDEOS

### Folder con trong khu Video theo khu của folder cha
# @ref videoArea
POST {{apiUrl}}/workspaces/{{contentWs.id}}/folders
Authorization: Bearer {{member.accessToken}}
Content-Type: application/json

{ "name": "Buổi 1", "parentId": "{{videoArea.id}}" }

?? status == 201
?? body section == VIDEOS

### Khai báo section khác khu của folder cha → 400
# @ref videoArea
POST {{apiUrl}}/workspaces/{{contentWs.id}}/folders
Authorization: Bearer {{member.accessToken}}
Content-Type: application/json

{ "name": "Sai khu", "parentId": "{{videoArea.id}}", "section": "DOCS" }

?? status == 400

### Gốc khu Tài liệu không chứa folder khu Video
# @ref videoArea
GET {{apiUrl}}/workspaces/{{contentWs.id}}/nodes
Authorization: Bearer {{member.accessToken}}

?? status == 200
?? js response.parsedBody.items.some(n => n.id === videoArea.id) == false

### Gốc khu Video (?section=VIDEOS)
# @ref videoArea
GET {{apiUrl}}/workspaces/{{contentWs.id}}/nodes?section=VIDEOS
Authorization: Bearer {{member.accessToken}}

?? status == 200
?? js response.parsedBody.items.some(n => n.id === videoArea.id) == true
?? js response.parsedBody.items.every(n => n.section === 'VIDEOS') == true

### Di chuyển sang khu khác → 400
# @ref videoArea
# @ref projects
POST {{apiUrl}}/nodes/{{projects.id}}/move
Authorization: Bearer {{member.accessToken}}
Content-Type: application/json

{ "targetParentId": "{{videoArea.id}}" }

?? status == 400

### Hoạt động trên mục: ADMIN workspace (OWNER) xem được, có lượt đổi tên
# @ref creator
# @ref mockups
GET {{apiUrl}}/nodes/{{mockups.id}}/activity
Authorization: Bearer {{creator.accessToken}}

?? status == 200
?? js response.parsedBody.items.some(a => a.action === 'node.rename' && a.actor.email === 'qa.creator@lunatech.vn') == true
?? js 'nextCursor' in response.parsedBody == true

### Hoạt động: MEMBER (EDITOR) dù là người tạo mục → 403
# @ref member
# @ref mockups
GET {{apiUrl}}/nodes/{{mockups.id}}/activity
Authorization: Bearer {{member.accessToken}}

?? status == 403

### Hoạt động: người được share "Chỉ xem" → 403
# @ref sharedViewer
# @ref handbook
GET {{apiUrl}}/nodes/{{handbook.id}}/activity
Authorization: Bearer {{sharedViewer.accessToken}}

?? status == 403

### Hoạt động: System Admin xem được
# @ref admin
# @ref mockups
GET {{apiUrl}}/nodes/{{mockups.id}}/activity
Authorization: Bearer {{admin.accessToken}}

?? status == 200
?? js response.parsedBody.items.length >= 1

### Workspace công ty: member chỉ là VIEWER của "lunatech"
# @name companyWs
# @ref member
GET {{apiUrl}}/workspaces
Authorization: Bearer {{member.accessToken}}

?? status == 200
?? js response.parsedBody.some(w => w.slug === 'lunatech' && w.kind === 'COMPANY' && w.myRole === 'VIEWER') == true

### Workspace công ty: VIEWER không tạo được folder ở gốc → 403
# @ref companyWs
POST {{apiUrl}}/workspaces/{{companyWs.find(w => w.slug === 'lunatech').id}}/folders
Authorization: Bearer {{member.accessToken}}
Content-Type: application/json

{ "name": "Không được {{$timestamp}}" }

?? status == 403
