# @import ./_auth.http
@apiUrl = http://localhost:4000/api/v1

# member (MEMBER → EDITOR) tạo các folder; creator là ADMIN workspace (OWNER) nên quản lý share.
# Người tạo mục không còn tự là OWNER.
# Share "Chỉ xem" (VIEWER): xem + comment. Share "Được chỉnh sửa" (EDITOR) → OWNER: thêm quản lý share, xem hoạt động.

### Folder cha (người ngoài sẽ không thấy)
# @name dept
# @ref member
# @ref ws
POST {{apiUrl}}/workspaces/{{contentWs.id}}/folders
Authorization: Bearer {{member.accessToken}}
Content-Type: application/json

{ "name": "Phòng Marketing" }

?? status == 201

### Folder sẽ được share
# @name sharedFolder
# @ref dept
POST {{apiUrl}}/workspaces/{{contentWs.id}}/folders
Authorization: Bearer {{member.accessToken}}
Content-Type: application/json

{ "name": "Chiến dịch Q4", "parentId": "{{dept.id}}" }

?? status == 201

### Folder con bên trong (kế thừa quyền share)
# @name subFolder
# @ref sharedFolder
POST {{apiUrl}}/workspaces/{{contentWs.id}}/folders
Authorization: Bearer {{member.accessToken}}
Content-Type: application/json

{ "name": "Banner", "parentId": "{{sharedFolder.id}}" }

?? status == 201

### Thành viên MEMBER (EDITOR) không share được → 403
# @ref member
# @ref sharedFolder
POST {{apiUrl}}/nodes/{{sharedFolder.id}}/shares
Authorization: Bearer {{member.accessToken}}
Content-Type: application/json

{ "email": "qa.outsider@lunatech.vn", "role": "VIEWER" }

?? status == 403

### Thành viên MEMBER (EDITOR) không xem danh sách share → 403
# @ref member
# @ref sharedFolder
GET {{apiUrl}}/nodes/{{sharedFolder.id}}/shares
Authorization: Bearer {{member.accessToken}}

?? status == 403

### ADMIN workspace (OWNER) share "Chỉ xem" cho người ngoài workspace
# @name share
# @ref outsider
# @ref sharedFolder
POST {{apiUrl}}/nodes/{{sharedFolder.id}}/shares
Authorization: Bearer {{creator.accessToken}}
Content-Type: application/json

{ "email": "qa.outsider@lunatech.vn", "role": "VIEWER" }

?? status == 201
?? body role == VIEWER
?? body user.email == qa.outsider@lunatech.vn

### Share trùng → 409
# @ref share
POST {{apiUrl}}/nodes/{{sharedFolder.id}}/shares
Authorization: Bearer {{creator.accessToken}}
Content-Type: application/json

{ "email": "qa.outsider@lunatech.vn", "role": "EDITOR" }

?? status == 409

### Người được share thấy trong "Được chia sẻ với tôi"
# @ref share
GET {{apiUrl}}/shared-with-me
Authorization: Bearer {{outsider.accessToken}}

?? status == 200
?? js response.parsedBody.some(s => s.node.id === sharedFolder.id && s.shareRole === 'VIEWER') == true

### Người được share xem folder con (quyền kế thừa)
# @ref share
# @ref subFolder
GET {{apiUrl}}/workspaces/{{contentWs.id}}/nodes?parentId={{sharedFolder.id}}
Authorization: Bearer {{outsider.accessToken}}

?? status == 200
?? js response.parsedBody.items[0].name == Banner

### Breadcrumb chỉ từ folder được share trở xuống
# @ref share
# @ref subFolder
GET {{apiUrl}}/nodes/{{subFolder.id}}/breadcrumb
Authorization: Bearer {{outsider.accessToken}}

?? status == 200
?? js response.parsedBody.map(x => x.name).join(' / ') == Chiến dịch Q4 / Banner

### Không xem được folder cha → 404
# @ref share
GET {{apiUrl}}/nodes/{{dept.id}}
Authorization: Bearer {{outsider.accessToken}}

?? status == 404

### Không xem được gốc workspace → 404
# @ref share
GET {{apiUrl}}/workspaces/{{contentWs.id}}/nodes
Authorization: Bearer {{outsider.accessToken}}

?? status == 404

### Folder con do member tạo (để thử quyền xóa của người được share)
# @name tempFolder
# @ref sharedFolder
POST {{apiUrl}}/workspaces/{{contentWs.id}}/folders
Authorization: Bearer {{member.accessToken}}
Content-Type: application/json

{ "name": "Tạm", "parentId": "{{sharedFolder.id}}" }

?? status == 201

### Share "Chỉ xem": mở folder con → VIEWER
# @ref share
# @ref subFolder
GET {{apiUrl}}/nodes/{{subFolder.id}}
Authorization: Bearer {{outsider.accessToken}}

?? status == 200
?? body myRole == VIEWER

### Share "Chỉ xem" không đổi tên được → 403
# @ref share
# @ref subFolder
PATCH {{apiUrl}}/nodes/{{subFolder.id}}
Authorization: Bearer {{outsider.accessToken}}
Content-Type: application/json

{ "name": "Đổi tên" }

?? status == 403

### Share "Chỉ xem" không xóa được → 403
# @ref share
# @ref tempFolder
DELETE {{apiUrl}}/nodes/{{tempFolder.id}}
Authorization: Bearer {{outsider.accessToken}}

?? status == 403

### Share "Chỉ xem" không tạo được → 403
# @ref share
POST {{apiUrl}}/workspaces/{{contentWs.id}}/folders
Authorization: Bearer {{outsider.accessToken}}
Content-Type: application/json

{ "name": "Thử", "parentId": "{{sharedFolder.id}}" }

?? status == 403

### Nâng share lên EDITOR ("Được chỉnh sửa")
# @ref share
PATCH {{apiUrl}}/nodes/{{sharedFolder.id}}/shares/{{share.id}}
Authorization: Bearer {{creator.accessToken}}
Content-Type: application/json

{ "role": "EDITOR" }

?? status == 200
?? body role == EDITOR

### Share "Được chỉnh sửa" → OWNER trên folder được share và mục con
# @ref share
# @ref subFolder
GET {{apiUrl}}/nodes/{{subFolder.id}}
Authorization: Bearer {{outsider.accessToken}}

?? status == 200
?? body myRole == OWNER

### Giờ người được share tạo được folder bên trong
# @ref share
# @ref subFolder
POST {{apiUrl}}/workspaces/{{contentWs.id}}/folders
Authorization: Bearer {{outsider.accessToken}}
Content-Type: application/json

{ "name": "Của khách", "parentId": "{{subFolder.id}}" }

?? status == 201

### Danh sách share ở folder con: có share kế thừa
# @ref share
# @ref subFolder
GET {{apiUrl}}/nodes/{{subFolder.id}}/shares
Authorization: Bearer {{creator.accessToken}}

?? status == 200
?? js response.parsedBody.direct.length == 0
?? js response.parsedBody.inherited[0].fromNode.name == Chiến dịch Q4

### Share "Được chỉnh sửa" quản lý được share (xem danh sách)
# @ref share
GET {{apiUrl}}/nodes/{{sharedFolder.id}}/shares
Authorization: Bearer {{outsider.accessToken}}

?? status == 200
?? js response.parsedBody.direct.some(s => s.id === share.id) == true

### Share "Được chỉnh sửa" xóa được mục người khác tạo bên trong
# @ref share
# @ref tempFolder
DELETE {{apiUrl}}/nodes/{{tempFolder.id}}
Authorization: Bearer {{outsider.accessToken}}

?? status == 204

### Thu hồi share
# @ref share
DELETE {{apiUrl}}/nodes/{{sharedFolder.id}}/shares/{{share.id}}
Authorization: Bearer {{creator.accessToken}}

?? status == 204

### Mất quyền ngay sau khi thu hồi → 404
# @ref share
# @ref subFolder
GET {{apiUrl}}/nodes/{{subFolder.id}}
Authorization: Bearer {{outsider.accessToken}}

?? status == 404

### Folder cho người được share "Được chỉnh sửa"
# @name editFolder
# @ref dept
POST {{apiUrl}}/workspaces/{{contentWs.id}}/folders
Authorization: Bearer {{member.accessToken}}
Content-Type: application/json

{ "name": "Hợp đồng {{$timestamp}}", "parentId": "{{dept.id}}" }

?? status == 201

### Mục bên trong do member tạo
# @name editChild
# @ref editFolder
POST {{apiUrl}}/workspaces/{{contentWs.id}}/folders
Authorization: Bearer {{member.accessToken}}
Content-Type: application/json

{ "name": "Bản nháp", "parentId": "{{editFolder.id}}" }

?? status == 201

### Share "Được chỉnh sửa" cho sharedEditor
# @name editShare
# @ref editChild
# @ref sharedEditor
POST {{apiUrl}}/nodes/{{editFolder.id}}/shares
Authorization: Bearer {{creator.accessToken}}
Content-Type: application/json

{ "email": "qa.shared.editor@lunatech.vn", "role": "EDITOR" }

?? status == 201
?? body role == EDITOR

### sharedEditor là OWNER trên mục con
# @ref editShare
GET {{apiUrl}}/nodes/{{editChild.id}}
Authorization: Bearer {{sharedEditor.accessToken}}

?? status == 200
?? body myRole == OWNER

### sharedEditor xem được danh sách share
# @ref editShare
GET {{apiUrl}}/nodes/{{editFolder.id}}/shares
Authorization: Bearer {{sharedEditor.accessToken}}

?? status == 200

### sharedEditor xem được hoạt động
# @ref editShare
GET {{apiUrl}}/nodes/{{editChild.id}}/activity
Authorization: Bearer {{sharedEditor.accessToken}}

?? status == 200

### sharedEditor xoá được mục do member tạo
# @ref editShare
DELETE {{apiUrl}}/nodes/{{editChild.id}}
Authorization: Bearer {{sharedEditor.accessToken}}

?? status == 204

### sharedEditor không thấy thư mục cha ngoài nhánh được share → 404
# @ref editShare
GET {{apiUrl}}/nodes/{{dept.id}}
Authorization: Bearer {{sharedEditor.accessToken}}

?? status == 404
