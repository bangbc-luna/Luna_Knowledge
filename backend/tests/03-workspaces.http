# @import ./_auth.http
@apiUrl = http://localhost:4000/api/v1

# Workspace chỉ có một vai trò thành viên: MEMBER. Chỉ System Admin tạo / sửa / xóa workspace.

### Thành viên thường không tạo được workspace → 403
# @ref creator
POST {{apiUrl}}/workspaces
Authorization: Bearer {{creator.accessToken}}
Content-Type: application/json

{ "name": "Không được", "slug": "khong-duoc-{{$timestamp}}" }

?? status == 403

### Admin tạo workspace kèm thành viên ban đầu (admin không tự thành thành viên)
# @name createWs
# @ref admin
# @ref creator
# @ref member
POST {{apiUrl}}/workspaces
Authorization: Bearer {{admin.accessToken}}
Content-Type: application/json

{
  "name": "QA Marketing",
  "slug": "qa-marketing-{{$timestamp}}",
  "description": "Workspace để test",
  "icon": "📣",
  "memberEmails": ["qa.creator@lunatech.vn", "qa.member@lunatech.vn", "QA.Creator@lunatech.vn"]
}

?? status == 201
?? body name == QA Marketing
?? body memberCount == 2
?? body myRole isFalse
?? js response.parsedBody.owner === undefined == true

### Admin tạo workspace trống (không có thành viên)
# @ref admin
POST {{apiUrl}}/workspaces
Authorization: Bearer {{admin.accessToken}}
Content-Type: application/json

{ "name": "QA Trống", "slug": "qa-trong-{{$timestamp}}" }

?? status == 201
?? body memberCount == 0

### Slug trùng → 409
# @ref admin
# @ref createWs
POST {{apiUrl}}/workspaces
Authorization: Bearer {{admin.accessToken}}
Content-Type: application/json

{ "name": "Trùng", "slug": "{{createWs.slug}}" }

?? status == 409
?? body error.code == CONFLICT

### Dữ liệu sai → 400 kèm lỗi từng trường
# @ref admin
POST {{apiUrl}}/workspaces
Authorization: Bearer {{admin.accessToken}}
Content-Type: application/json

{ "name": "", "slug": "Bad Slug", "memberEmails": ["not-an-email"] }

?? status == 400
?? js response.parsedBody.error.details.length == 3

### Thành viên ngoài công ty → 400
# @ref admin
POST {{apiUrl}}/workspaces
Authorization: Bearer {{admin.accessToken}}
Content-Type: application/json

{ "name": "Ngoài", "slug": "ngoai-{{$timestamp}}", "memberEmails": ["someone@gmail.com"] }

?? status == 400

### Thành viên chưa từng đăng nhập → tạo sẵn user
# @ref admin
POST {{apiUrl}}/workspaces
Authorization: Bearer {{admin.accessToken}}
Content-Type: application/json

{ "name": "QA Sales", "slug": "qa-sales-{{$timestamp}}", "memberEmails": ["qa.future.member@lunatech.vn"] }

?? status == 201
?? body memberCount == 1

### Workspace của tôi: vai trò MEMBER
# @ref creator
# @ref createWs
GET {{apiUrl}}/workspaces
Authorization: Bearer {{creator.accessToken}}

?? status == 200
?? js response.parsedBody.some(w => w.id === createWs.id && w.myRole === 'MEMBER') == true

### Admin xem tất cả (scope=all)
# @ref admin
# @ref createWs
GET {{apiUrl}}/workspaces?scope=all
Authorization: Bearer {{admin.accessToken}}

?? status == 200
?? js response.parsedBody.some(w => w.id === createWs.id && w.myRole === null) == true

### User thường dùng scope=all → 403
# @ref creator
GET {{apiUrl}}/workspaces?scope=all
Authorization: Bearer {{creator.accessToken}}

?? status == 403

### Chi tiết workspace (thành viên)
# @ref creator
# @ref createWs
GET {{apiUrl}}/workspaces/{{createWs.id}}
Authorization: Bearer {{creator.accessToken}}

?? status == 200
?? body myRole == MEMBER

### System Admin xem chi tiết dù không phải thành viên
# @ref admin
# @ref createWs
GET {{apiUrl}}/workspaces/{{createWs.id}}
Authorization: Bearer {{admin.accessToken}}

?? status == 200
?? body myRole isFalse

### Người ngoài xem → 404
# @ref outsider
# @ref createWs
GET {{apiUrl}}/workspaces/{{createWs.id}}
Authorization: Bearer {{outsider.accessToken}}

?? status == 404

### Id không phải UUID → 400
# @ref creator
GET {{apiUrl}}/workspaces/abc
Authorization: Bearer {{creator.accessToken}}

?? status == 400

### Thành viên không sửa được workspace → 403
# @ref creator
# @ref createWs
PATCH {{apiUrl}}/workspaces/{{createWs.id}}
Authorization: Bearer {{creator.accessToken}}
Content-Type: application/json

{ "name": "Hack" }

?? status == 403

### Admin sửa workspace
# @ref admin
# @ref createWs
PATCH {{apiUrl}}/workspaces/{{createWs.id}}
Authorization: Bearer {{admin.accessToken}}
Content-Type: application/json

{ "name": "QA Marketing (đã sửa)", "description": "Mô tả mới", "icon": null }

?? status == 200
?? body name == QA Marketing (đã sửa)
?? body icon isFalse

### Sửa với body rỗng → 400
# @ref admin
# @ref createWs
PATCH {{apiUrl}}/workspaces/{{createWs.id}}
Authorization: Bearer {{admin.accessToken}}
Content-Type: application/json

{}

?? status == 400

### Người ngoài sửa → 404
# @ref outsider
# @ref createWs
PATCH {{apiUrl}}/workspaces/{{createWs.id}}
Authorization: Bearer {{outsider.accessToken}}
Content-Type: application/json

{ "name": "Hack" }

?? status == 404

### Người ngoài xóa → 404
# @ref outsider
# @ref createWs
DELETE {{apiUrl}}/workspaces/{{createWs.id}}
Authorization: Bearer {{outsider.accessToken}}

?? status == 404

### Thành viên không xóa được workspace → 403
# @ref member
# @ref createWs
DELETE {{apiUrl}}/workspaces/{{createWs.id}}
Authorization: Bearer {{member.accessToken}}

?? status == 403

### Admin xóa workspace → 204
# @ref admin
# @ref createWs
DELETE {{apiUrl}}/workspaces/{{createWs.id}}
Authorization: Bearer {{admin.accessToken}}

?? status == 204

### Sau khi xóa → 404
# @ref creator
# @ref createWs
GET {{apiUrl}}/workspaces/{{createWs.id}}
Authorization: Bearer {{creator.accessToken}}

?? status == 404

### Tạo lại với slug vừa xóa → 201
# @ref admin
# @ref createWs
POST {{apiUrl}}/workspaces
Authorization: Bearer {{admin.accessToken}}
Content-Type: application/json

{ "name": "QA Marketing", "slug": "{{createWs.slug}}" }

?? status == 201

### User mới đăng nhập lần đầu → tự vào workspace "lunatech" (MEMBER)
# @name newcomer
POST {{apiUrl}}/dev/token
Content-Type: application/json

{ "email": "qa.newcomer.{{$timestamp}}@lunatech.vn", "name": "QA Newcomer" }

?? status == 200

###
# @ref newcomer
GET {{apiUrl}}/workspaces
Authorization: Bearer {{newcomer.accessToken}}

?? status == 200
?? js response.parsedBody.some(w => w.slug === 'lunatech' && w.myRole === 'MEMBER') == true
