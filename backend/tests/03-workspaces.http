# @import ./_auth.http
@apiUrl = http://localhost:4000/api/v1

# Hai loại workspace:
#   COMPANY: workspace công ty "lunatech" (có sẵn từ seed), ai đăng nhập cũng tự vào với vai trò VIEWER; không xóa được.
#   TEAM: ai cũng tạo được; người tạo là ADMIN, memberEmails là MEMBER.
# ADMIN workspace (hoặc System Admin) sửa / xóa workspace; MEMBER → 403; người ngoài → 404.

### User thường tạo workspace nhóm kèm thành viên ban đầu → người tạo là ADMIN
# @name createWs
# @ref creator
# @ref member
POST {{apiUrl}}/workspaces
Authorization: Bearer {{creator.accessToken}}
Content-Type: application/json

{
  "name": "QA Marketing",
  "slug": "qa-marketing-{{$timestamp}}",
  "description": "Workspace để test",
  "icon": "📣",
  "memberEmails": ["qa.member@lunatech.vn", "QA.Member@lunatech.vn", "qa.creator@lunatech.vn"]
}

?? status == 201
?? body name == QA Marketing
?? body kind == TEAM
?? body memberCount == 2
?? body myRole == ADMIN
?? js response.parsedBody.owner === undefined == true

### Người tạo là ADMIN, memberEmails là MEMBER
# @ref createWs
GET {{apiUrl}}/workspaces/{{createWs.id}}/members
Authorization: Bearer {{creator.accessToken}}

?? status == 200
?? js response.parsedBody.find(m => m.user.email === 'qa.creator@lunatech.vn').role == ADMIN
?? js response.parsedBody.find(m => m.user.email === 'qa.member@lunatech.vn').role == MEMBER

### Bất kỳ ai cũng tạo được workspace trống (chỉ có mình là ADMIN)
# @name emptyWs
# @ref outsider
POST {{apiUrl}}/workspaces
Authorization: Bearer {{outsider.accessToken}}
Content-Type: application/json

{ "name": "QA Trống", "slug": "qa-trong-{{$timestamp}}" }

?? status == 201
?? body kind == TEAM
?? body memberCount == 1
?? body myRole == ADMIN

### Slug trùng → 409
# @ref createWs
POST {{apiUrl}}/workspaces
Authorization: Bearer {{member.accessToken}}
Content-Type: application/json

{ "name": "Trùng", "slug": "{{createWs.slug}}" }

?? status == 409
?? body error.code == CONFLICT

### Dữ liệu sai → 400 kèm lỗi từng trường
# @ref creator
POST {{apiUrl}}/workspaces
Authorization: Bearer {{creator.accessToken}}
Content-Type: application/json

{ "name": "", "slug": "Bad Slug", "memberEmails": ["not-an-email"] }

?? status == 400
?? js response.parsedBody.error.details.length == 3

### Thành viên ngoài công ty → 400
# @ref creator
POST {{apiUrl}}/workspaces
Authorization: Bearer {{creator.accessToken}}
Content-Type: application/json

{ "name": "Ngoài", "slug": "ngoai-{{$timestamp}}", "memberEmails": ["someone@gmail.com"] }

?? status == 400

### Thành viên chưa từng đăng nhập → tạo sẵn user
# @name salesWs
# @ref creator
POST {{apiUrl}}/workspaces
Authorization: Bearer {{creator.accessToken}}
Content-Type: application/json

{ "name": "QA Sales", "slug": "qa-sales-{{$timestamp}}", "memberEmails": ["qa.future.member@lunatech.vn"] }

?? status == 201
?? body memberCount == 2

### Workspace của tôi: member là MEMBER
# @ref member
# @ref createWs
GET {{apiUrl}}/workspaces
Authorization: Bearer {{member.accessToken}}

?? status == 200
?? js response.parsedBody.some(w => w.id === createWs.id && w.myRole === 'MEMBER') == true

### Workspace của tôi: creator là ADMIN
# @ref createWs
GET {{apiUrl}}/workspaces
Authorization: Bearer {{creator.accessToken}}

?? status == 200
?? js response.parsedBody.some(w => w.id === createWs.id && w.myRole === 'ADMIN') == true

### Admin xem tất cả (scope=all)
# @ref admin
# @ref createWs
GET {{apiUrl}}/workspaces?scope=all
Authorization: Bearer {{admin.accessToken}}

?? status == 200
?? js response.parsedBody.some(w => w.id === createWs.id && w.myRole === null) == true

### User thường dùng scope=all → 403
# @ref creator
GET {{apiUrl}}/workspaces?scope=all
Authorization: Bearer {{creator.accessToken}}

?? status == 403

### Chi tiết workspace (thành viên)
# @ref member
# @ref createWs
GET {{apiUrl}}/workspaces/{{createWs.id}}
Authorization: Bearer {{member.accessToken}}

?? status == 200
?? body myRole == MEMBER

### System Admin xem chi tiết dù không phải thành viên
# @ref admin
# @ref createWs
GET {{apiUrl}}/workspaces/{{createWs.id}}
Authorization: Bearer {{admin.accessToken}}

?? status == 200
?? body myRole isFalse

### Người ngoài xem → 404
# @ref outsider
# @ref createWs
GET {{apiUrl}}/workspaces/{{createWs.id}}
Authorization: Bearer {{outsider.accessToken}}

?? status == 404

### Id không phải UUID → 400
# @ref creator
GET {{apiUrl}}/workspaces/abc
Authorization: Bearer {{creator.accessToken}}

?? status == 400

### MEMBER không sửa được workspace → 403
# @ref member
# @ref createWs
PATCH {{apiUrl}}/workspaces/{{createWs.id}}
Authorization: Bearer {{member.accessToken}}
Content-Type: application/json

{ "name": "Hack" }

?? status == 403

### ADMIN workspace sửa workspace
# @ref creator
# @ref createWs
PATCH {{apiUrl}}/workspaces/{{createWs.id}}
Authorization: Bearer {{creator.accessToken}}
Content-Type: application/json

{ "name": "QA Marketing (đã sửa)", "description": "Mô tả mới", "icon": null }

?? status == 200
?? body name == QA Marketing (đã sửa)
?? body icon isFalse
?? body myRole == ADMIN

### System Admin cũng sửa được
# @ref admin
# @ref createWs
PATCH {{apiUrl}}/workspaces/{{createWs.id}}
Authorization: Bearer {{admin.accessToken}}
Content-Type: application/json

{ "description": "Admin sửa" }

?? status == 200
?? body description == Admin sửa

### Sửa với body rỗng → 400
# @ref creator
# @ref createWs
PATCH {{apiUrl}}/workspaces/{{createWs.id}}
Authorization: Bearer {{creator.accessToken}}
Content-Type: application/json

{}

?? status == 400

### Người ngoài sửa → 404
# @ref outsider
# @ref createWs
PATCH {{apiUrl}}/workspaces/{{createWs.id}}
Authorization: Bearer {{outsider.accessToken}}
Content-Type: application/json

{ "name": "Hack" }

?? status == 404

### Người ngoài xóa → 404
# @ref outsider
# @ref createWs
DELETE {{apiUrl}}/workspaces/{{createWs.id}}
Authorization: Bearer {{outsider.accessToken}}

?? status == 404

### MEMBER không xóa được workspace → 403
# @ref member
# @ref createWs
DELETE {{apiUrl}}/workspaces/{{createWs.id}}
Authorization: Bearer {{member.accessToken}}

?? status == 403

### ADMIN workspace xóa workspace → 204
# @ref creator
# @ref createWs
DELETE {{apiUrl}}/workspaces/{{createWs.id}}
Authorization: Bearer {{creator.accessToken}}

?? status == 204

### Sau khi xóa → 404
# @ref member
# @ref createWs
GET {{apiUrl}}/workspaces/{{createWs.id}}
Authorization: Bearer {{member.accessToken}}

?? status == 404

### Tạo lại với slug vừa xóa → 201
# @name recreated
# @ref creator
# @ref createWs
POST {{apiUrl}}/workspaces
Authorization: Bearer {{creator.accessToken}}
Content-Type: application/json

{ "name": "QA Marketing", "slug": "{{createWs.slug}}" }

?? status == 201

### System Admin xóa workspace nhóm → 204
# @ref admin
# @ref recreated
DELETE {{apiUrl}}/workspaces/{{recreated.id}}
Authorization: Bearer {{admin.accessToken}}

?? status == 204

### Dọn dẹp: người tạo xóa workspace trống
# @ref emptyWs
DELETE {{apiUrl}}/workspaces/{{emptyWs.id}}
Authorization: Bearer {{outsider.accessToken}}

?? status == 204

### Dọn dẹp: xóa workspace QA Sales
# @ref salesWs
DELETE {{apiUrl}}/workspaces/{{salesWs.id}}
Authorization: Bearer {{creator.accessToken}}

?? status == 204

### Workspace công ty: user thường là VIEWER
# @name companyWs
# @ref member
GET {{apiUrl}}/workspaces
Authorization: Bearer {{member.accessToken}}

?? status == 200
?? js response.parsedBody.some(w => w.slug === 'lunatech' && w.kind === 'COMPANY' && w.myRole === 'VIEWER') == true

### Workspace công ty: VIEWER không sửa được → 403
# @ref companyWs
PATCH {{apiUrl}}/workspaces/{{companyWs.find(w => w.slug === 'lunatech').id}}
Authorization: Bearer {{member.accessToken}}
Content-Type: application/json

{ "name": "Hack" }

?? status == 403

### Workspace công ty: VIEWER không xóa được → 403
# @ref companyWs
DELETE {{apiUrl}}/workspaces/{{companyWs.find(w => w.slug === 'lunatech').id}}
Authorization: Bearer {{member.accessToken}}

?? status == 403

### Workspace công ty: kể cả System Admin cũng không xóa được → 403
# @ref admin
# @ref companyWs
DELETE {{apiUrl}}/workspaces/{{companyWs.find(w => w.slug === 'lunatech').id}}
Authorization: Bearer {{admin.accessToken}}

?? status == 403

### User mới đăng nhập lần đầu → tự vào workspace "lunatech" (VIEWER)
# @name newcomer
POST {{apiUrl}}/dev/token
Content-Type: application/json

{ "email": "qa.newcomer.{{$timestamp}}@lunatech.vn", "name": "QA Newcomer" }

?? status == 200

###
# @ref newcomer
GET {{apiUrl}}/workspaces
Authorization: Bearer {{newcomer.accessToken}}

?? status == 200
?? js response.parsedBody.some(w => w.slug === 'lunatech' && w.kind === 'COMPANY' && w.myRole === 'VIEWER') == true
