{
  "name": "@luna/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:coverage": "vitest run --config ./vitest.config.coverage.ts",
    "openapi:types": "nest build && node dist/openapi/export.js --write",
    "openapi:check": "node dist/openapi/export.js --check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@luna/db": "workspace:*",
    "@luna/editor": "workspace:^",
    "@luna/shared": "workspace:*",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "bullmq": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "diff": "9.0.0",
    "file-type": "^22.2.0",
    "helmet": "^8.3.0",
    "ioredis": "^5",
    "jose": "^6.2.12",
    "mammoth": "1.13.0",
    "multer": "^2",
    "nestjs-pino": "^5.3.1",
    "openid-client": "^6.8.8",
    "pino": "^10",
    "pino-http": "^11",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@luna/tsconfig": "workspace:*",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12",
    "@nestjs/testing": "^12.1.3",
    "@testcontainers/postgresql": "^12.2.0",
    "@testcontainers/redis": "^12.2.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5",
    "@types/multer": "^2.3.0",
    "@types/node": "^24",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7",
    "@vitest/coverage-v8": "4.1.11",
    "jszip": "3.10.2",
    "openapi-typescript": "7.13.0",
    "pg": "^8.16.3",
    "pino-pretty": "^13",
    "supertest": "^7",
    "testcontainers": "^12.2.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.2"
  }
}
