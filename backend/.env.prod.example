# Cấu hình production cho server văn phòng. Sao chép thành .env.prod rồi điền.
# Sinh secret: openssl rand -base64 48   (VIDEO_MASTER_KEY: openssl rand -base64 32)

# ---- Tên miền ----
APP_HOST=knowledge.lunatech.vn
MEDIA_HOST=media.knowledge.lunatech.vn
ACME_EMAIL=it@lunatech.vn
# Token Cloudflare có quyền Zone.DNS Edit cho lunatech.vn (cấp chứng chỉ Let's Encrypt qua DNS-01)
CF_DNS_API_TOKEN=
# Chỉ khi bật truy cập từ xa (profile remote)
CLOUDFLARE_TUNNEL_TOKEN=
LUNA_VERSION=latest
# Mạng edge có subnet cố định; Traefik chỉ tin X-Forwarded-For từ CLOUDFLARED_IP. Đổi khi trùng dải mạng LAN văn phòng
EDGE_SUBNET=172.30.0.0/24
EDGE_GATEWAY=172.30.0.1
CLOUDFLARED_IP=172.30.0.250

# ---- Chung ----
NODE_ENV=production
LOG_LEVEL=info
API_PORT=4000
COLLAB_PORT=4001
API_PUBLIC_URL=https://knowledge.lunatech.vn
WEB_PUBLIC_URL=https://knowledge.lunatech.vn
CORS_ORIGINS=https://knowledge.lunatech.vn
COLLAB_INTERNAL_URL=http://collab:4001
COLLAB_PUBLIC_URL=wss://knowledge.lunatech.vn/collab
TRUST_PROXY=loopback, uniquelocal

# ---- PostgreSQL ----
POSTGRES_USER=luna
POSTGRES_PASSWORD=
POSTGRES_DB=luna
DATABASE_URL=postgresql://luna:<POSTGRES_PASSWORD>@postgres:5432/luna?schema=public
DB_POOL_MAX=30
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_TX_TIMEOUT_MS=60000
HTTP_KEEP_ALIVE_TIMEOUT_MS=95000

# ---- Redis ----
REDIS_URL=redis://redis:6379

# ---- MinIO ----
MINIO_ROOT_USER=luna_minio
MINIO_ROOT_PASSWORD=
# Thư mục dữ liệu trên ổ lớn có RAID; để trống thì dùng volume Docker
MINIO_DATA_DIR=/srv/luna/minio
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://media.knowledge.lunatech.vn
S3_REGION=us-east-1
S3_ACCESS_KEY=luna_minio
S3_SECRET_KEY=<MINIO_ROOT_PASSWORD>
S3_FORCE_PATH_STYLE=true
S3_BUCKET_TMP=luna-tmp
S3_BUCKET_HLS=luna-hls
S3_BUCKET_PREVIEWS=luna-previews
S3_BUCKET_THUMBNAILS=luna-thumbnails
S3_BUCKET_ASSETS=luna-assets
S3_BUCKET_ORIGINALS=luna-originals
UPLOAD_MAX_FILE_MB=500
UPLOAD_MAX_VIDEO_MB=10240

# ---- Tìm kiếm, xử lý file ----
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=
TIKA_URL=http://tika:9998
GOTENBERG_URL=http://gotenberg:3000

# ---- Đăng nhập Google ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_GOOGLE_DOMAINS=lunatech.vn
JWT_ACCESS_SECRET=
SESSION_IDLE_TIMEOUT_MIN=60
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# ---- Video ----
VIDEO_MASTER_KEY=
VIDEO_ENCODER=libx264
VIDEO_TRANSCODE_CONCURRENCY=1
REMOTE_VIDEO_MAX_HEIGHT=720
FILE_PROCESS_CONCURRENCY=2

# ---- Soạn thảo cộng tác ----
COLLAB_TOKEN_SECRET=
COLLAB_INTERNAL_SECRET=

# ---- Bảo mật, quan sát ----
RATE_LIMIT_USER_PER_MIN=600
RATE_LIMIT_ANON_PER_MIN=120
METRICS_TOKEN=
WORKER_METRICS_PORT=9464
SENTRY_DSN=

# ---- Backup (chạy trên máy chủ bằng cron, xem docs/DEPLOY.md) ----
BACKUP_DEST=/mnt/luna-backup
BACKUP_PASSWORD=
BACKUP_KEEP_DAYS=30

# ---- Cổng trên máy chủ (đổi khi chạy thử cạnh stack khác) ----
# HTTP_PORT=80
# HTTPS_PORT=443
# POSTGRES_HOST_PORT=5432
# MINIO_HOST_PORT=9000
