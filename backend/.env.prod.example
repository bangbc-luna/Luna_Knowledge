# Cấu hình production cho server văn phòng. Sao chép thành .env.prod rồi điền.
# Sinh secret: openssl rand -base64 48   (VIDEO_MASTER_KEY: openssl rand -base64 32)
# Mật khẩu nằm trong URL (POSTGRES_PASSWORD, mật khẩu luna_app_user trong DATABASE_URL, REDIS_PASSWORD) phải sinh bằng openssl rand -hex 32: base64 có / + = làm hỏng URL. Các secret khác dùng base64 được

# ---- Tên miền ----
APP_HOST=knowledge.lunatech.vn
MEDIA_HOST=media.knowledge.lunatech.vn
ACME_EMAIL=it@lunatech.vn
# Token Cloudflare có quyền Zone.DNS Edit cho lunatech.vn (cấp chứng chỉ Let's Encrypt qua DNS-01)
CF_DNS_API_TOKEN=
# Chỉ khi bật truy cập từ xa (profile remote)
CLOUDFLARE_TUNNEL_TOKEN=
LUNA_VERSION=latest
# Mạng edge có subnet cố định; Traefik chỉ tin X-Forwarded-For từ CLOUDFLARED_IP. Đổi khi trùng dải mạng LAN văn phòng
EDGE_SUBNET=172.30.0.0/24
EDGE_GATEWAY=172.30.0.1
CLOUDFLARED_IP=172.30.0.250

# ---- Chung ----
NODE_ENV=production
LOG_LEVEL=info
API_PORT=4000
COLLAB_PORT=4001
API_PUBLIC_URL=https://knowledge.lunatech.vn
WEB_PUBLIC_URL=https://knowledge.lunatech.vn
CORS_ORIGINS=https://knowledge.lunatech.vn
COLLAB_INTERNAL_URL=http://collab:4001
COLLAB_PUBLIC_URL=wss://knowledge.lunatech.vn/collab
TRUST_PROXY=loopback, uniquelocal

# ---- PostgreSQL ----
POSTGRES_USER=luna
POSTGRES_PASSWORD=
POSTGRES_DB=luna
# migrate, backup, restore chạy bằng user chủ DB; app (api, worker, collab) chạy bằng login riêng do migrate tự tạo
DATABASE_MIGRATE_URL=postgresql://luna:<POSTGRES_PASSWORD>@postgres:5432/luna?schema=public
DATABASE_URL=postgresql://luna_app_user:<APP_DB_PASSWORD>@postgres:5432/luna?schema=public
DB_POOL_MAX=30
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_TX_TIMEOUT_MS=60000
HTTP_KEEP_ALIVE_TIMEOUT_MS=95000

# ---- Redis ----
REDIS_PASSWORD=
# REDIS_URL must embed the same password as REDIS_PASSWORD
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379

# ---- MinIO ----
MINIO_ROOT_USER=luna_minio
MINIO_ROOT_PASSWORD=
# Thư mục dữ liệu trên ổ lớn có RAID; để trống thì dùng volume Docker
MINIO_DATA_DIR=/srv/luna/minio
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://media.knowledge.lunatech.vn
S3_REGION=us-east-1
# User MinIO riêng của app (không phải root), do minio-init tạo; S3_SECRET_KEY phải khác MINIO_ROOT_PASSWORD
S3_ACCESS_KEY=luna_app
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_BUCKET_TMP=luna-tmp
S3_BUCKET_HLS=luna-hls
S3_BUCKET_PREVIEWS=luna-previews
S3_BUCKET_THUMBNAILS=luna-thumbnails
S3_BUCKET_ASSETS=luna-assets
S3_BUCKET_ORIGINALS=luna-originals
S3_BUCKET_MEETING_AUDIO=luna-meeting-audio
UPLOAD_MAX_FILE_MB=500
UPLOAD_MAX_VIDEO_MB=10240

# ---- Tìm kiếm, xử lý file ----
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=
TIKA_URL=http://tika:9998
GOTENBERG_URL=http://gotenberg:3000

# ---- Đăng nhập Google ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_GOOGLE_DOMAINS=lunatech.vn
JWT_ACCESS_SECRET=
SESSION_IDLE_TIMEOUT_MIN=60
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# ---- Video ----
VIDEO_MASTER_KEY=
VIDEO_ENCODER=libx264
VIDEO_TRANSCODE_CONCURRENCY=1
REMOTE_VIDEO_MAX_HEIGHT=720
FILE_PROCESS_CONCURRENCY=2
WORKSPACE_PURGE_DAYS=30
AUTO_VERSION_THIN_DAYS=30

# ---- Soạn thảo cộng tác ----
COLLAB_TOKEN_SECRET=
COLLAB_INTERNAL_SECRET=

# ---- Bảo mật, quan sát ----
RATE_LIMIT_USER_PER_MIN=600
RATE_LIMIT_ANON_PER_MIN=120
# Bắt buộc ở production (collab từ chối khởi động nếu thiếu). Sinh bằng: openssl rand -base64 32
METRICS_TOKEN=
WORKER_METRICS_PORT=9464
SENTRY_DSN=
# Mật khẩu admin Grafana (profile monitoring)
GRAFANA_ADMIN_PASSWORD=

# ---- Backup (chạy trên máy chủ bằng cron, xem docs/DEPLOY.md) ----
BACKUP_DEST=/mnt/luna-backup
BACKUP_PASSWORD=
BACKUP_KEEP_DAYS=30

# ---- Cổng trên máy chủ (đổi khi chạy thử cạnh stack khác) ----
# HTTP_PORT=80
# HTTPS_PORT=443
# POSTGRES_HOST_PORT=5432
# MINIO_HOST_PORT=9000

# ---- Meetings (LiveKit, xem docs/DEPLOY.md mục 10) ----
# Hai cách: (1) LiveKit Cloud: LIVEKIT_URL=wss://<project>.livekit.cloud, key lấy từ Project Settings.
# (2) Tự cài: LIVEKIT_URL=wss://livekit.<APP_HOST>, tự tạo cặp key/secret rồi chạy profile livekit (mục "Tự cài LiveKit").
# Đổi giữa hai cách chỉ cần đổi 3 biến LIVEKIT_* rồi build lại frontend. LIVEKIT_HOST, LIVEKIT_CERT_DIR (tuỳ chọn) chỉ dùng khi tự cài.
# api và worker đều đọc nhóm biến này; LIVEKIT_URL còn dùng khi build frontend (CSP), đổi thì phải build lại frontend
# LIVEKIT_API_SECRET tối thiểu 32 ký tự. Webhook: https://<APP_HOST>/api/v1/meetings/livekit/webhook
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
MEETING_TOKEN_TTL_SEC=600
MEETING_EMPTY_GRACE_SEC=120
MEETING_EARLY_JOIN_MIN=15
MEETING_MAX_PARTICIPANTS=25
MEETING_REMINDER_MINUTES=10

# ---- Biên bản AI (xem docs/DEPLOY.md mục "Biên bản AI") ----
# Mặc định none: tắt hẳn biên bản AI, API báo aiNotesAvailable=false và không tạo biên bản. Chỉ bật khi cả hai provider khác none
# Production không cho dùng fake. Khoá nhà cung cấp chỉ khai ở worker; api và recorder không cần các khoá này
# STT: deepgram | gemini | omniroute | none. LLM: anthropic | omniroute | none
MEETING_STT_PROVIDER=none
MEETING_LLM_PROVIDER=none
DEEPGRAM_API_KEY=
DEEPGRAM_LANGUAGE=vi
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
MEETING_LLM_MODEL=claude-opus-5-5
MEETING_LLM_EFFORT=medium
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
MEETING_OMNIROUTE_STT_MODEL=auto/gemini-3.8-flash
MEETING_OMNIROUTE_LLM_MODEL=auto/gemini-3.8-flash
# Giá để ước tính chi phí hiển thị cho admin (USD): STT theo phút, LLM theo triệu token
MEETING_STT_USD_PER_MIN=0.0043
MEETING_LLM_USD_PER_MTOK_IN=4
MEETING_LLM_USD_PER_MTOK_OUT=20
# LiveKit tự cài thì để 0; LiveKit Cloud nhập giá theo người-phút
MEETING_LIVEKIT_USD_PER_PARTICIPANT_MIN=0
# Từ khoá chuyên ngành, cách nhau bởi dấu phẩy, giúp STT nghe đúng
MEETING_KEYTERMS=
# MEETING_AUDIO_WAIT_SEC phải giống nhau ở api và worker
MEETING_AUDIO_WAIT_SEC=900
MEETING_MINUTES_CONCURRENCY=1
MEETING_AUDIO_RETENTION_DAYS=7
MEETING_RECORDER_CONCURRENCY=3
RECORDER_TMP_DIR=/var/tmp/luna-recorder
RECORDER_METRICS_PORT=9465
