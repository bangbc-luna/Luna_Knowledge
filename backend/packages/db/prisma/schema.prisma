generator client {
  provider            = "prisma-client"
  previewFeatures     = ["partialIndexes"]
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum WorkspaceRole {
  ADMIN
  MEMBER
  VIEWER
}

enum WorkspaceKind {
  COMPANY
  TEAM
}

enum NodeSection {
  DOCS
  VIDEOS
}

enum NodeType {
  FOLDER
  DOCUMENT
  FILE
  VIDEO
}

enum NodeStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum BlobKind {
  ORIGINAL
  PREVIEW
  THUMBNAIL
  HLS
  POSTER
  SPRITE
  ASSET
}

enum StorageProvider {
  S3
  GDRIVE
}

enum UploadStatus {
  PENDING
  COMPLETED
  ABORTED
}

enum ShareRole {
  EDITOR
  VIEWER
}

model User {
  id            String     @id @default(uuid(7)) @db.Uuid
  email         String     @unique
  name          String
  avatarUrl     String?    @map("avatar_url")
  isSystemAdmin Boolean    @default(false) @map("is_system_admin")
  status        UserStatus @default(ACTIVE)
  lastLoginAt   DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions          Session[]
  memberships       WorkspaceMember[] @relation("member")
  addedMemberships  WorkspaceMember[] @relation("addedBy")
  createdWorkspaces Workspace[]
  createdNodes      Node[]            @relation("nodeCreatedBy")
  updatedNodes      Node[]            @relation("nodeUpdatedBy")
  deletedNodes      Node[]            @relation("nodeDeletedBy")
  shares            NodeShare[]       @relation("shareUser")
  grantedShares     NodeShare[]       @relation("shareGrantedBy")
  favorites         Favorite[]
  recentViews       RecentView[]
  fileVersions      FileVersion[]
  uploadSessions    UploadSession[]
  videoWatches      VideoWatch[]
  docVersions       DocumentVersion[]
  threadsCreated    CommentThread[]   @relation("threadCreatedBy")
  threadsResolved   CommentThread[]   @relation("threadResolvedBy")
  comments          Comment[]
  notifications     Notification[]
  documentAssets    DocumentAsset[]
  editedDocuments   Document[]        @relation("documentLastEditor")

  @@map("users")
}

model Session {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason     String?   @map("revoked_reason")
  ip                String?
  userAgent         String?   @map("user_agent")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(3)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

model Workspace {
  id          String        @id @default(uuid(7)) @db.Uuid
  name        String
  slug        String        @unique
  kind        WorkspaceKind @default(TEAM)
  description String?
  icon        String?
  createdById String        @map("created_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(3)

  createdBy User              @relation(fields: [createdById], references: [id])
  members   WorkspaceMember[]
  nodes     Node[]
  tags      Tag[]

  @@unique([kind], map: "workspaces_single_company", where: raw("kind = 'COMPANY' AND deleted_at IS NULL"))
  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole
  addedById   String?       @map("added_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("member", fields: [userId], references: [id], onDelete: Cascade)
  addedBy   User?     @relation("addedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorId     String?  @map("actor_id") @db.Uuid
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  workspaceId String?  @map("workspace_id") @db.Uuid
  metadata    Json?
  ip          String?
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([targetId, id(sort: Desc)])
  @@index([workspaceId, id(sort: Desc)])
  @@index([actorId, id(sort: Desc)])
  @@index([action, id(sort: Desc)])
  @@index([createdAt], type: Brin)
  @@map("audit_logs")
}

model Node {
  id             String                @id @default(uuid(7)) @db.Uuid
  workspaceId    String                @map("workspace_id") @db.Uuid
  parentId       String?               @map("parent_id") @db.Uuid
  type           NodeType
  section        NodeSection           @default(DOCS)
  name           String
  nameNormalized String                @map("name_normalized")
  description    String?
  path           Unsupported("ltree")?
  status         NodeStatus            @default(READY)
  createdById    String                @map("created_by") @db.Uuid
  updatedById    String?               @map("updated_by") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?             @map("deleted_at") @db.Timestamptz(3)
  deletedById    String?               @map("deleted_by") @db.Uuid
  deletedRootId  String?               @map("deleted_root_id") @db.Uuid

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent      Node?             @relation("tree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Node[]            @relation("tree")
  createdBy   User              @relation("nodeCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?             @relation("nodeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedBy   User?             @relation("nodeDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  shares      NodeShare[]
  tags        NodeTag[]
  favorites   Favorite[]
  recents     RecentView[]
  blobs       Blob[]
  file        FileInfo?
  versions    FileVersion[]
  uploads     UploadSession[]
  video       Video?
  watches     VideoWatch[]
  document    Document?
  docVersions DocumentVersion[]
  threads     CommentThread[]
  assets      DocumentAsset[]

  @@unique([parentId, nameNormalized], map: "nodes_unique_name_in_folder", where: raw("deleted_at IS NULL AND parent_id IS NOT NULL"))
  @@unique([workspaceId, section, nameNormalized], map: "nodes_unique_name_at_root", where: raw("deleted_at IS NULL AND parent_id IS NULL"))
  @@index([path], type: Gist)
  @@index([parentId])
  @@index([workspaceId])
  @@index([workspaceId, section, updatedAt])
  @@index([deletedRootId], map: "nodes_deleted_root_id_idx", where: raw("deleted_root_id IS NOT NULL"))
  @@map("nodes")
}

model NodeShare {
  id          String    @id @default(uuid(7)) @db.Uuid
  nodeId      String    @map("node_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  role        ShareRole
  grantedById String?   @map("granted_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  node      Node  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  user      User  @relation("shareUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("shareGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([nodeId, userId])
  @@index([userId])
  @@map("node_shares")
}

model Tag {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  color       String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  nodes     NodeTag[]

  @@unique([workspaceId, name])
  @@map("tags")
}

model NodeTag {
  nodeId String @map("node_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([nodeId, tagId])
  @@index([tagId])
  @@map("node_tags")
}

model Favorite {
  userId    String   @map("user_id") @db.Uuid
  nodeId    String   @map("node_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([userId, nodeId])
  @@index([nodeId])
  @@map("favorites")
}

model RecentView {
  userId   String   @map("user_id") @db.Uuid
  nodeId   String   @map("node_id") @db.Uuid
  viewedAt DateTime @default(now()) @map("viewed_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([userId, nodeId])
  @@index([userId, viewedAt(sort: Desc)])
  @@index([nodeId])
  @@map("recent_views")
}

model Blob {
  id        String          @id @default(uuid(7)) @db.Uuid
  nodeId    String          @map("node_id") @db.Uuid
  kind      BlobKind
  provider  StorageProvider
  container String
  key       String
  sizeBytes BigInt          @map("size_bytes")
  mime      String
  sha256    String?
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  node          Node           @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  originalOf    FileVersion[]  @relation("versionOriginal")
  previewOf     FileVersion[]  @relation("versionPreview")
  thumbnailOf   FileVersion[]  @relation("versionThumbnail")
  documentAsset DocumentAsset?
  hlsOf         Video[]        @relation("videoHls")
  posterOf      Video[]        @relation("videoPoster")
  spriteOf      Video[]        @relation("videoSprite")

  @@unique([provider, container, key])
  @@index([nodeId])
  @@index([sha256])
  @@map("blobs")
}

model FileInfo {
  nodeId           String    @id @map("node_id") @db.Uuid
  currentVersionId String?   @unique @map("current_version_id") @db.Uuid
  extractedText    String?   @map("extracted_text")
  extractedAt      DateTime? @map("extracted_at") @db.Timestamptz(3)
  processingError  String?   @map("processing_error")

  node           Node         @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  currentVersion FileVersion? @relation("currentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  @@map("files")
}

model FileVersion {
  id              String   @id @default(uuid(7)) @db.Uuid
  nodeId          String   @map("node_id") @db.Uuid
  versionNo       Int      @map("version_no")
  fileName        String   @map("file_name")
  originalBlobId  String   @map("original_blob_id") @db.Uuid
  previewBlobId   String?  @map("preview_blob_id") @db.Uuid
  thumbnailBlobId String?  @map("thumbnail_blob_id") @db.Uuid
  previewKind     String   @default("none") @map("preview_kind")
  uploadedById    String   @map("uploaded_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  node       Node      @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  original   Blob      @relation("versionOriginal", fields: [originalBlobId], references: [id], onDelete: Cascade)
  preview    Blob?     @relation("versionPreview", fields: [previewBlobId], references: [id], onDelete: SetNull)
  thumbnail  Blob?     @relation("versionThumbnail", fields: [thumbnailBlobId], references: [id], onDelete: SetNull)
  uploadedBy User      @relation(fields: [uploadedById], references: [id])
  currentOf  FileInfo? @relation("currentVersion")
  videos     Video[]

  @@unique([nodeId, versionNo])
  @@index([originalBlobId])
  @@index([previewBlobId])
  @@index([thumbnailBlobId])
  @@map("file_versions")
}

model UploadSession {
  id           String       @id @default(uuid(7)) @db.Uuid
  nodeId       String       @map("node_id") @db.Uuid
  workspaceId  String       @map("workspace_id") @db.Uuid
  s3UploadId   String       @map("s3_upload_id")
  tmpKey       String       @map("tmp_key")
  fileName     String       @map("file_name")
  sizeBytes    BigInt       @map("size_bytes")
  partSize     Int          @map("part_size")
  partCount    Int          @map("part_count")
  mimeDeclared String       @map("mime_declared")
  isNewVersion Boolean      @default(false) @map("is_new_version")
  status       UploadStatus @default(PENDING)
  createdById  String       @map("created_by") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime     @map("expires_at") @db.Timestamptz(3)

  node      Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id])

  @@index([status, expiresAt])
  @@index([nodeId])
  @@map("upload_sessions")
}

model BlobGc {
  id        BigInt          @id @default(autoincrement())
  provider  StorageProvider
  container String
  key       String
  attempts  Int             @default(0)
  lastError String?         @map("last_error")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("blob_gc")
}

model Video {
  nodeId       String   @id @map("node_id") @db.Uuid
  versionId    String   @map("version_id") @db.Uuid
  durationSec  Float    @map("duration_sec")
  width        Int
  height       Int
  renditions   Json
  hlsBlobId    String   @map("hls_blob_id") @db.Uuid
  posterBlobId String?  @map("poster_blob_id") @db.Uuid
  spriteBlobId String?  @map("sprite_blob_id") @db.Uuid
  spriteVtt    String?  @map("sprite_vtt")
  keyEncrypted Bytes    @map("key_encrypted")
  viewCount    Int      @default(0) @map("view_count")
  transcodedAt DateTime @default(now()) @map("transcoded_at") @db.Timestamptz(3)

  node    Node        @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  version FileVersion @relation(fields: [versionId], references: [id], onDelete: NoAction)
  hls     Blob        @relation("videoHls", fields: [hlsBlobId], references: [id], onDelete: NoAction)
  poster  Blob?       @relation("videoPoster", fields: [posterBlobId], references: [id], onDelete: SetNull)
  sprite  Blob?       @relation("videoSprite", fields: [spriteBlobId], references: [id], onDelete: SetNull)

  @@index([versionId])
  @@index([hlsBlobId])
  @@index([posterBlobId])
  @@index([spriteBlobId])
  @@map("videos")
}

model VideoWatch {
  userId      String   @map("user_id") @db.Uuid
  nodeId      String   @map("node_id") @db.Uuid
  positionSec Float    @map("position_sec")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([userId, nodeId])
  @@index([nodeId])
  @@map("video_watch_progress")
}

enum ThreadStatus {
  OPEN
  RESOLVED
}

enum DocumentFormat {
  RICH
  LATEX
}

model Document {
  nodeId            String         @id @map("node_id") @db.Uuid
  format            DocumentFormat @default(RICH)
  yjsState          Bytes?         @map("yjs_state")
  contentJson       Json?          @map("content_json")
  contentText       String?        @map("content_text")
  wordCount         Int            @default(0) @map("word_count")
  lastEditedAt      DateTime?      @map("last_edited_at") @db.Timestamptz(3)
  lastEditedBy      String?        @map("last_edited_by") @db.Uuid
  lastVersionAt     DateTime?      @map("last_version_at") @db.Timestamptz(3)
  dirtySinceVersion Boolean        @default(false) @map("dirty_since_version")

  node       Node  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  lastEditor User? @relation("documentLastEditor", fields: [lastEditedBy], references: [id], onDelete: SetNull)

  @@index([lastEditedBy])
  @@map("documents")
}

model DocumentVersion {
  id             String   @id @default(uuid(7)) @db.Uuid
  nodeId         String   @map("node_id") @db.Uuid
  versionNo      Int      @map("version_no")
  name           String?
  isAuto         Boolean  @default(false) @map("is_auto")
  restoredFromId String?  @map("restored_from_id") @db.Uuid
  yjsSnapshot    Bytes    @map("yjs_snapshot")
  contentJson    Json     @map("content_json")
  contentText    String   @map("content_text")
  wordCount      Int      @default(0) @map("word_count")
  wordsAdded     Int      @default(0) @map("words_added")
  wordsRemoved   Int      @default(0) @map("words_removed")
  createdById    String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  node         Node              @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  createdBy    User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  restoredFrom DocumentVersion?  @relation("versionRestore", fields: [restoredFromId], references: [id], onDelete: SetNull)
  restoredTo   DocumentVersion[] @relation("versionRestore")

  @@unique([nodeId, versionNo])
  @@index([restoredFromId], map: "document_versions_restored_from_id_idx", where: raw("restored_from_id IS NOT NULL"))
  @@map("document_versions")
}

model CommentThread {
  id           String       @id @default(uuid(7)) @db.Uuid
  nodeId       String       @map("node_id") @db.Uuid
  quotedText   String       @map("quoted_text")
  status       ThreadStatus @default(OPEN)
  createdById  String       @map("created_by") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedById String?      @map("resolved_by") @db.Uuid
  resolvedAt   DateTime?    @map("resolved_at") @db.Timestamptz(3)

  node       Node      @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  createdBy  User      @relation("threadCreatedBy", fields: [createdById], references: [id])
  resolvedBy User?     @relation("threadResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  comments   Comment[]

  @@index([nodeId, status])
  @@map("comment_threads")
}

model Comment {
  id        String    @id @default(uuid(7)) @db.Uuid
  threadId  String    @map("thread_id") @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  body      String
  mentions  String[]  @default([]) @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  editedAt  DateTime? @map("edited_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  thread CommentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id])

  @@index([threadId, createdAt])
  @@map("comments")
}

model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  payload   Json
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, id(sort: Desc)])
  @@index([userId], map: "notifications_unread_idx", where: raw("read_at IS NULL"))
  @@map("notifications")
}

model DocumentAsset {
  id          String   @id @default(uuid(7)) @db.Uuid
  nodeId      String   @map("node_id") @db.Uuid
  blobId      String   @unique @map("blob_id") @db.Uuid
  fileName    String   @map("file_name")
  createdById String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  node      Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  blob      Blob @relation(fields: [blobId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id])

  @@index([nodeId])
  @@map("document_assets")
}
