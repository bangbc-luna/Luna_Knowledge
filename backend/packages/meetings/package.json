{
  "name": "@luna/meetings",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@luna/db": "workspace:*",
    "@luna/editor": "workspace:*",
    "@luna/shared": "workspace:*",
    "livekit-server-sdk": "2.19.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@luna/tsconfig": "workspace:*",
    "@tiptap/pm": "3.31.4",
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.2"
  }
}
