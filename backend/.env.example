# ---- Chung ----
NODE_ENV=development
LOG_LEVEL=debug
# Địa chỉ API, collab, worker nghe. Mặc định: 127.0.0.1 khi development (máy khác trong LAN không vào được), 0.0.0.0 khi khác.
# LISTEN_HOST=0.0.0.0

# ---- API ----
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ---- Collab (Hocuspocus) ----
COLLAB_PORT=4001

# ---- PostgreSQL ----
POSTGRES_USER=luna
POSTGRES_PASSWORD=luna_dev_password
POSTGRES_DB=luna
POSTGRES_PORT=5432
DATABASE_URL=postgresql://luna:luna_dev_password@localhost:5432/luna?schema=public

# ---- Redis ----
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- MinIO / S3 ----
MINIO_ROOT_USER=luna_minio
MINIO_ROOT_PASSWORD=luna_minio_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=luna_minio
S3_SECRET_KEY=luna_minio_dev_password
S3_FORCE_PATH_STYLE=true
S3_BUCKET_TMP=luna-tmp
S3_BUCKET_HLS=luna-hls
S3_BUCKET_PREVIEWS=luna-previews
S3_BUCKET_THUMBNAILS=luna-thumbnails
S3_BUCKET_ASSETS=luna-assets
S3_BUCKET_ORIGINALS=luna-originals
# Địa chỉ trình duyệt tới MinIO (URL ký sẵn). Để trống = S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=https://files.example.com

# ---- Upload / lưu trữ file gốc ----
UPLOAD_MAX_FILE_MB=500
UPLOAD_MAX_VIDEO_MB=10240

# ---- Meilisearch ----
MEILI_PORT=7700
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=luna_meili_dev_master_key_change_me

# ---- Tika / Gotenberg ----
TIKA_PORT=9998
TIKA_URL=http://localhost:9998
GOTENBERG_PORT=3100
GOTENBERG_URL=http://localhost:3100

# ---- Auth (Phase 1) ----
ALLOWED_GOOGLE_DOMAINS=lunatech.vn
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
SESSION_IDLE_TIMEOUT_MIN=60
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
# Sau khi đăng nhập Google, chuyển về trang đăng nhập của frontend (frontend tự đổi cookie lấy token).
AUTH_REDIRECT_URL=http://localhost:5173/login

# ---- Seed ----
SEED_ADMIN_EMAIL=admin@lunatech.vn

# ---- Backup (pnpm backup, SPEC §5.6) ----
# Đường dẫn tuyệt đối (ổ ngoài) hoặc remote rclone (vd. b2:luna-backup, cấu hình bằng RCLONE_CONFIG_B2_*).
BACKUP_DEST=/mnt/luna-backup
# Mật khẩu mã hoá kho backup. MẤT MẬT KHẨU LÀ MẤT BACKUP: cất ở nơi khác ngoài máy chủ.
BACKUP_PASSWORD=
BACKUP_KEEP_DAYS=30

# ---- Video (Phase 4) ----
# 32 byte base64 (openssl rand -base64 32). Mã hoá khoá AES của từng video; giữ cùng backup.
VIDEO_MASTER_KEY=
# libx264 (CPU, mặc định) | h264_nvenc (GPU NVIDIA)
VIDEO_ENCODER=libx264
VIDEO_TRANSCODE_CONCURRENCY=1
REMOTE_VIDEO_MAX_HEIGHT=720
# Thư mục tạm của worker (trên đĩa, không dùng tmpfs): video 1 giờ cần vài GB
WORKER_TMP_DIR=/var/tmp

# ---- Collab (Phase 5) ----
# Ký collab token (API) và xác thực lệnh nội bộ API -> collab. openssl rand -hex 32
COLLAB_TOKEN_SECRET=
COLLAB_INTERNAL_SECRET=
COLLAB_INTERNAL_URL=http://localhost:4001


# Bảo mật API: số request mỗi phút cho mỗi người dùng đã đăng nhập / mỗi IP chưa đăng nhập
RATE_LIMIT_USER_PER_MIN=600
RATE_LIMIT_ANON_PER_MIN=120
BODY_LIMIT=512kb
# Swagger /api/docs: mặc định bật ở dev, tắt ở production
# SWAGGER_ENABLED=false

# Quan sát hệ thống: /metrics (Prometheus) ở API :4000, collab :4001, worker :WORKER_METRICS_PORT.
# Không đặt METRICS_TOKEN thì chỉ mạng nội bộ đọc được; đặt thì phải gửi "Authorization: Bearer <token>".
# METRICS_TOKEN=
WORKER_METRICS_PORT=9464
# Sentry: để trống thì tắt
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# Số kết nối Postgres tối đa của API (mặc định 30; worker và collab dùng 5)
# DB_POOL_MAX=30
